<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Siniskalc.Heroes.ViewModels;assembly=Siniskalc.Heroes"
    xmlns:wvm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels"
    xmlns:local="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
    xmlns:views="clr-namespace:Siniskalc.Heroes.Wpf.Views">

    <ResourceDictionary.MergedDictionaries>
        <!-- The colours and the styles of the controls that every page uses; the styles below are the ones of the pages of a Heroes game. -->
        <ResourceDictionary Source="pack://application:,,,/Siniskalc.Wpf;component/Styles/SiniskalcStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- A panel of a tab: hidden unless the tab with its number is the picked one (SelectedTab of the page). -->
    <Style x:Key="TabPanelBase" TargetType="FrameworkElement">
        <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
    <Style x:Key="TabPanel0" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="0">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel1" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="1">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel2" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="2">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel3" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="3">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel4" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="4">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel5" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="5">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel6" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="6">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="TabPanel7" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding SelectedTab}" Value="7">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- A note that is only shown while its Tag is False: "This player has no heroes". -->
    <Style x:Key="EmptyNoteStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The small "edited" mark and Reset of the header of a page, shown while the savegame holds unsaved edits of it. -->
    <Style x:Key="EditedMarkStyle" TargetType="Border">
        <Setter Property="Margin" Value="12,0,0,4"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ResetPillStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Margin" Value="6,0,0,4"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- One slot of artifacts: its name, the button that opens the picker, and a button that takes the artifact off. -->
    <DataTemplate x:Key="ArtifactSlotRowTemplate" DataType="{x:Type wvm:ArtifactPickerViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}"/>
            <views:ArtifactSlotPicker Grid.Column="1"/>
            <Button Grid.Column="2" Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}"
                    Width="26" Height="26" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                    ToolTip="Take this artifact off" AutomationProperties.Name="{Binding Label, StringFormat=Clear {0}}"/>
        </Grid>
    </DataTemplate>

    <!-- One line of a card: what it is on the left, its value, and a smaller note after it. -->
    <DataTemplate x:Key="FactRowTemplate" DataType="{x:Type vm:FactRow}">
        <StackPanel Orientation="Horizontal" Margin="0,3">
            <TextBlock Width="130" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}"/>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Value}"/>
            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Note}"/>
        </StackPanel>
    </DataTemplate>

    <!-- A hero or a town of the player: the name opens it, the detail sits on the right. -->
    <DataTemplate x:Key="LinkTemplate" DataType="{x:Type vm:LinkViewModel}">
        <DockPanel Margin="0,3">
            <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"/>
            <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Command="{Binding OpenCommand}" Content="{Binding Name}"
                    ToolTip="Open"/>
        </DockPanel>
    </DataTemplate>

    <!-- The controls of the pages. They come last: a StaticResource finds only what is defined above it. -->
    <!-- The strip of tabs under the header of a page: a ListBox of NavButtons, with SelectedIndex bound to SelectedTab. -->
    <Style x:Key="TabStripStyle" TargetType="ListBox">
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="Margin" Value="16,0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The header of a page: the marker, the name, what the page adds (its content), and the "edited" mark and Reset. -->
    <Style TargetType="{x:Type views:PageHeader}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:PageHeader}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center"
                                 Fill="{Binding ColorHex, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock FontSize="24" FontWeight="SemiBold" Text="{TemplateBinding Title}"/>
                        <ContentPresenter VerticalAlignment="Bottom"/>
                        <Border Style="{StaticResource EditedMarkStyle}" ToolTip="{TemplateBinding EditedToolTip}">
                            <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <Button Style="{StaticResource ResetPillStyle}" Content="Reset" Command="{Binding ResetCommand}"
                                ToolTip="{TemplateBinding ResetToolTip}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- One resource of a player as a line of the resources card: its colour, its name, a stepper, the button that adds a fixed amount, and what is told
         about it (how far it is from the savegame, its income). -->
    <DataTemplate x:Key="ResourceLineTemplate" DataType="{x:Type wvm:ResourceRowViewModel}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}"/>
            <local:Stepper Grid.Column="1" Width="170" Value="{Binding Value}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Step="{Binding Step}"/>
            <Button Grid.Column="2" Margin="8,0,0,0" MinWidth="48" VerticalAlignment="Center" Style="{StaticResource PillButtonStyle}"
                    Command="{Binding AddPresetCommand}" Content="{Binding AddPresetLabel}" ToolTip="{Binding AddPresetToolTip}"/>
            <StackPanel Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" Text="{Binding DeltaText}"/>
                <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0" Text="{Binding Note}"/>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- The resources of a player: what a game adds first (its content, such as the countdown to banishing), then a card of double width with a line for
         each resource in the order of the game and the quick add buttons, and the note on the limits. -->
    <Style TargetType="{x:Type views:ResourcesPanel}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:ResourcesPanel}">
                    <StackPanel>
                        <ContentPresenter/>

                        <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0" HorizontalAlignment="Left" Width="672">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Resources"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" Text="Quick"/>
                                    <Button Style="{StaticResource PillButtonStyle}" Command="{Binding SetAllResourcesCommand}" Content="{Binding SetAllLabel}"
                                            ToolTip="Add the same to wood, mercury, ore, sulfur, crystal and gems; gold is left alone"/>
                                    <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Command="{Binding SetRichCommand}" Content="{Binding SetRichLabel}"
                                            ToolTip="Add to gold"/>
                                    <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Command="{Binding ClearAllResourcesCommand}" Content="Res 0"
                                            ToolTip="Set wood, mercury, ore, sulfur, crystal and gems to 0; gold is left alone"/>
                                    <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Command="{Binding ClearRichCommand}" Content="Gold 0"
                                            ToolTip="Set gold to 0"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Resources}" ItemTemplate="{StaticResource ResourceLineTemplate}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Text="{TemplateBinding Note}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A card with a heading and a list, and a note that shows while the list is empty. -->
    <Style TargetType="{x:Type views:ItemsCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:ItemsCard}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{TemplateBinding Heading}"/>
                            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}" ItemTemplate="{TemplateBinding ItemTemplate}"/>
                            <TextBlock Style="{StaticResource EmptyNoteStyle}" Tag="{TemplateBinding HasItems}" Text="{TemplateBinding EmptyText}"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The card of the tavern of a player. -->
    <Style TargetType="{x:Type views:TavernCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:TavernCard}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,8" Text="Tavern"/>
                            <ItemsControl ItemsSource="{TemplateBinding ItemsSource}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type wvm:TavernPlaceViewModel}">
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}"/>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenCommand}" Content="Open"
                                                    ToolTip="Go to Hero"/>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding SelectedKey}" SelectedValuePath="Key" DisplayMemberPath="Name"
                                                      ToolTip="The hero the tavern of this player offers for hire."/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The choice of who owns a hero or a castle. -->
    <Style TargetType="{x:Type views:OwnerPicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:OwnerPicker}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Owner" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                        <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{Binding OwnerChoices}" SelectedItem="{Binding SelectedOwner}"
                                  ToolTip="{TemplateBinding PickerToolTip}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A card with a heading, a summary on the right of it, and what the page puts in it. -->
    <Style TargetType="{x:Type views:HeadedCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:HeadedCard}">
                    <Border Style="{StaticResource CardStyle}" Width="{TemplateBinding CardWidth}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldNoteStyle}" Text="{TemplateBinding Summary}"/>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0" Text="{TemplateBinding Heading}"/>
                            </DockPanel>
                            <ContentPresenter/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The rows of a list card: no padding, and a mark on the left of the row that is picked, which is also the row that has the focus. The
         mark takes 6 pixels, the same as the inset of the headings of the columns above the rows; the list itself keeps a pixel around its rows,
         which the -1 margin of the list takes back. -->
    <Style x:Key="ListCardRowStyle" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="mark" BorderThickness="2,0,0,0" BorderBrush="Transparent" Padding="4,0,0,0" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="mark" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="IsSelected" Value="True"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- A card that lists the places of the map (mines, dwellings, obelisks): a heading, a note, buttons that act on every row, the headings of the
         columns (the content) and a row for each item. -->
    <Style TargetType="{x:Type views:ListCard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:ListCard}">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Left" Width="{TemplateBinding CardWidth}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource FieldNoteStyle}" Text="{TemplateBinding Summary}"/>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0" Text="{TemplateBinding Heading}"/>
                            </DockPanel>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{TemplateBinding Note}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                        <Style.Triggers>
                                            <Trigger Property="Text" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ContentPresenter Content="{TemplateBinding Toolbar}"/>
                            <ContentPresenter Margin="0,0,0,2"/>
                            <ListBox x:Name="PART_List" ItemsSource="{TemplateBinding ItemsSource}" ItemTemplate="{TemplateBinding ItemTemplate}" ItemContainerStyle="{StaticResource ListCardRowStyle}"
                                     MaxHeight="{TemplateBinding ListMaxHeight}"
                                     SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                     BorderThickness="0" Padding="0" Margin="-7,0,0,0" Background="Transparent" HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The pill of a player who owns no town ("No towns: 6 days left", "Banished"), on the player's page and card. The data context has HasBanishing and IsBanished. -->
    <Style x:Key="BanishingPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="TextElement.FontSize" Value="12"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasBanishing}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsBanished}" Value="True">
                <Setter Property="Background" Value="#F6D5D5"/>
                <Setter Property="TextElement.Foreground" Value="#9B2226"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The links and the card of the overview. -->
        <!-- A hero of a player: the name opens it, the class and level sit on the right. -->
        <DataTemplate x:Key="HeroLinkTemplate" DataType="{x:Type vm:ILink}">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"/>
                <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Command="{Binding OpenCommand}" Content="{Binding Name}"
                        ToolTip="Go to Hero"/>
            </DockPanel>
        </DataTemplate>

        <!-- A hero in a castle, under it: its name, which opens the hero, then its role, such as "Nymus garrisoned - Tazar visiting". -->
        <DataTemplate x:Key="CastleHeroInlineTemplate" DataType="{x:Type wvm:CastleHeroRowViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="&#160;·&#160;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" FontSize="12" Command="{Binding OpenCommand}" Content="{Binding Name}"
                        ToolTip="Go to Hero"/>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding RoleText}"/>
            </StackPanel>
        </DataTemplate>
        <!-- A castle of a player: the name opens it, the faction sits on the right. -->
        <DataTemplate x:Key="CastleLinkTemplate" DataType="{x:Type wvm:CastleLinkViewModel}">
            <Border Margin="0,2" Padding="4,2" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapital}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasGrail}" Value="True">
                                <Setter Property="Background" Value="{StaticResource HighlightSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The marks sit before the name; what is under the name lines up with the name, not with the marks. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Text="♛" ToolTip="Capital">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapital}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource HighlightBrush}" Text="✦"
                                   ToolTip="{Binding GrailText, StringFormat='Grail: {0}'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGrail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"/>
                        <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Command="{Binding OpenCommand}" Content="{Binding Name}"
                                ToolTip="Go to Castle"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Style="{StaticResource FieldNoteStyle}" Text="{Binding Status}" ToolTip="The hall and the fortification of this settlement"/>
                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource CastleHeroInlineTemplate}" AlternationCount="100">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- A player in the order of play: its colour and name; the one whose turn it is lit in bronze, like a ticked tile. -->
        <ControlTemplate x:Key="OrderOfPlayButtonTemplate" TargetType="Button">
            <Border x:Name="tile" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                    Padding="12,7" SnapsToDevicePixels="True">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                    <TextBlock x:Name="name" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}"/>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <!-- A computer player, or a turn the editor cannot give yet: the button stays, greyed out, with its tooltip saying why. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="tile" Property="Opacity" Value="0.45"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="tile" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                    <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter TargetName="name" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate x:Key="OrderOfPlayItemTemplate" DataType="{x:Type wvm:OrderOfPlayItemViewModel}">
            <Button Template="{StaticResource OrderOfPlayButtonTemplate}" Margin="0,0,8,0" Cursor="Hand" Command="{Binding Command}" ToolTip="{Binding ToolTip}" IsEnabled="{Binding IsHuman}"
                    ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}"/>
        </DataTemplate>

        <DataTemplate x:Key="PlayerCardTemplate" DataType="{x:Type wvm:PlayerCardViewModel}">
            <Border Style="{StaticResource CardStyle}" Width="300">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                        <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding ControlText}"/>
                        <Button DockPanel.Dock="Left" Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                                Command="{Binding OpenCommand}" Content="{Binding Name}" ToolTip="Go to Player"/>
                        <Border Style="{StaticResource BanishingPillStyle}" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BanishingText}"/>
                        </Border>
                    </DockPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasResources}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <DockPanel Margin="0,3">
                            <TextBlock DockPanel.Dock="Right" FontFamily="Consolas" FontWeight="SemiBold" Text="{Binding Gold}"/>
                            <TextBlock Foreground="{StaticResource MutedBrush}" Text="Gold"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding OtherResources}"/>
                    </StackPanel>

                    <Rectangle Height="1" Margin="0,2,0,4" Fill="{StaticResource LineBrush}"/>
                    <ItemsControl ItemsSource="{Binding Castles}" ItemTemplate="{StaticResource CastleLinkTemplate}"/>
                    <Rectangle Height="1" Margin="0,4,0,4" Fill="{StaticResource LineBrush}">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCastles}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <ItemsControl ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource HeroLinkTemplate}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    <!-- The overview of a savegame: the map, the date and a card for each player. The page binds to what IOverviewPage says. -->
    <Style TargetType="{x:Type views:OverviewView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:OverviewView}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="16,14,16,16">
                    <!-- The top row: the savefile, then the map it was made on: its name, size and levels, and difficulty. -->
                    <WrapPanel>
                        <TextBlock Text="{Binding FileName}" FontSize="24" FontWeight="SemiBold" Margin="0,0,16,0" ToolTip="The savefile"/>
                        <TextBlock Margin="0,0,8,3" VerticalAlignment="Bottom" FontSize="16" FontWeight="SemiBold" Text="{Binding MapName}" ToolTip="The map">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,0,8,3" VerticalAlignment="Bottom" FontSize="14" Foreground="{StaticResource MutedBrush}" Text="{Binding MapSizeText, StringFormat='· {0}'}"
                                   ToolTip="The size of the map and how many levels it has">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MapSizeText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,0,0,3" VerticalAlignment="Bottom" FontSize="14" Foreground="{StaticResource MutedBrush}" Text="{Binding MapDifficultyText, StringFormat='· {0}'}"
                                   ToolTip="The difficulty rating the map was made with, not the difficulty the game was started at">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MapDifficultyText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </WrapPanel>
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding VersionName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Summary, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- The date and whose turn it is, on one row. -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Text="{Binding DateText}"
                                   ToolTip="The date in the game when the savegame was made">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" Text="{Binding TurnText}"
                                   ToolTip="The colour whose turn it was when the savegame was made">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <!-- What the map says about itself. -->
                    <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="4" Background="{StaticResource PanelBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMapDescription}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock TextWrapping="Wrap" Text="{Binding MapDescription}"/>
                    </Border>

                    <!-- Who plays after whom, and whose turn it is. -->
                    <Border HorizontalAlignment="Stretch">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                <Setter Property="Margin" Value="0,12,0,0"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasOrderOfPlay}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Order of play"/>
                            <ItemsControl ItemsSource="{Binding OrderOfPlay}" ItemTemplate="{StaticResource OrderOfPlayItemTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl Margin="-6,12,0,0" ItemsSource="{Binding Players}" ItemTemplate="{StaticResource PlayerCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <Border Margin="0,16,0,0" Padding="12,10" CornerRadius="4" Background="{StaticResource PanelBrush}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   Text="Changes are tracked under &quot;Pending changes&quot; until they saved. Saving stores a backup copy of the original file in the same folder."/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- A tile that lights up in the accent colour when it is on or ticked: war machines, adventure spells, obelisks, visited buildings. -->
    <ControlTemplate x:Key="TileTemplate" TargetType="ToggleButton">
        <Border x:Name="tile" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,8" SnapsToDevicePixels="True">
            <DockPanel>
                <TextBlock x:Name="tick" DockPanel.Dock="Right" Text="✓" FontWeight="Bold" VerticalAlignment="Top" Margin="8,0,0,0"
                           Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
                <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tile" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TileCheckBox" TargetType="CheckBox">
        <Setter Property="Template" Value="{StaticResource TileTemplate}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- A button that looks like the tiles above, for the actions that go with them ("All", "None"). -->
    <ControlTemplate x:Key="TileButtonTemplate" TargetType="Button">
        <Border x:Name="tile" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,8" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="tile" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="tile" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource TileButtonTemplate}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="TileRadioButton" TargetType="RadioButton">
        <Setter Property="Template" Value="{StaticResource TileTemplate}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
</ResourceDictionary>
