<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.ArmyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
             xmlns:vm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels"
             xmlns:local="clr-namespace:Siniskalc.Heroes.Wpf.Views">
    <!-- The army of a hero or the garrison of a castle: its slots and a finder to add creatures. The DataContext is an ArmyViewModelBase. -->
    <StackPanel IsEnabled="{Binding IsEditable}">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Title}"/>
                    <TextBlock Margin="16,0,0,8" Style="{StaticResource CardHeadingStyle}" FontWeight="Normal" Text="{Binding ArmySummary}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CreatureSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StackSlotViewModel}">
                            <Border Width="880" Margin="0,0,8,8" Padding="10,8" Background="White" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" CornerRadius="3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- The slot as the player counts it, left aligned and centered on the two rows. -->
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayNumber}" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,0" MinWidth="72" Content="{Binding UpgradeText}"
                                                    IsEnabled="{Binding HasUpgrade}" ToolTip="{Binding UpgradeToolTip}" Click="UpgradeClicked"/>
                                            <local:CreatureSlotPicker HorizontalAlignment="Stretch"/>
                                        </DockPanel>
                                        <!-- The size of the stack: the box takes what is left, so the last button ends under the edge of the Upgrade button. -->
                                        <DockPanel Margin="0,6,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Style="{StaticResource SlotButtonStyle}" Margin="4,0,0,0" Height="26" Content="+" Command="{Binding AdjustAmountCommand}" CommandParameter="1"
                                                        ToolTip="One more" AutomationProperties.Name="Add 1"/>
                                                <Button Style="{StaticResource SlotButtonStyle}" Margin="4,0,0,0" Height="26" Content="−" Command="{Binding AdjustAmountCommand}" CommandParameter="-1"
                                                        ToolTip="One less" AutomationProperties.Name="Remove 1"/>
                                                <Button Style="{StaticResource SlotButtonStyle}" Margin="8,0,0,0" Height="26" Content="+5" Command="{Binding AdjustAmountCommand}" CommandParameter="5"
                                                        ToolTip="Five more" AutomationProperties.Name="Add 5"/>
                                                <Button Style="{StaticResource SlotButtonStyle}" Margin="4,0,0,0" Height="26" Content="−5" Command="{Binding AdjustAmountCommand}" CommandParameter="-5"
                                                        ToolTip="Five less" AutomationProperties.Name="Remove 5"/>
                                            </StackPanel>
                                            <TextBox Width="Auto" Height="26" Margin="0" HorizontalContentAlignment="Right" IsEnabled="{Binding HasCreature}" ToolTip="How many creatures are in the stack"
                                                     AutomationProperties.Name="Amount" Text="{Binding CreatureAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DockPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SlotButtonStyle}" Content="▲" Command="{Binding MoveUpCommand}"
                                                ToolTip="Move this stack up" AutomationProperties.Name="Move up"/>
                                        <Button Style="{StaticResource SlotButtonStyle}" Content="▼" Command="{Binding MoveDownCommand}"
                                                ToolTip="Move this stack down" AutomationProperties.Name="Move down"/>
                                        <Button Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}"
                                                ToolTip="Empty this slot" AutomationProperties.Name="Clear slot"/>
                                    </StackPanel>

                                    <!-- What the whole stack is worth, as the game works it out from one creature: label above value, in a row. -->
                                    <ItemsControl Grid.Column="2" Margin="18,0,0,0" Width="450" HorizontalAlignment="Left" VerticalAlignment="Center" ItemsSource="{Binding Facts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel ItemWidth="90"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StackFact}">
                                                    <StackPanel Margin="0,0,6,2" ToolTip="{Binding ToolTip}">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Text="{Binding Label}"/>
                                                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding Value}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Look up a creature, and put it in the army. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Find creatures"/>
                <wpf:FinderView DataContext="{Binding Finder}">
                    <wpf:FinderView.ToolbarContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="New stack of" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox Width="64" Margin="0" HorizontalContentAlignment="Right"
                                     Text="{Binding AddAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="How many creatures a stack you add starts with"/>
                        </StackPanel>
                    </wpf:FinderView.ToolbarContent>
                </wpf:FinderView>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
