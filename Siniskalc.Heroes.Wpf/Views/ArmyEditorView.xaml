<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.ArmyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
             xmlns:vm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels"
             xmlns:local="clr-namespace:Siniskalc.Heroes.Wpf.Views">
    <!-- The army of a hero or the garrison of a castle: its slots and a finder to add creatures. The DataContext is an ArmyViewModelBase. -->
    <StackPanel IsEnabled="{Binding IsEditable}">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Title}"/>
                    <TextBlock Margin="16,0,0,8" Style="{StaticResource CardHeadingStyle}" FontWeight="Normal" Text="{Binding ArmySummary}"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CreatureSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StackSlotViewModel}">
                            <Border Width="880" Margin="0,0,8,8" Padding="10,8" Background="White" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" CornerRadius="3">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayNumber, StringFormat=Slot {0}}" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="▲" Command="{Binding MoveUpCommand}"
                                                    ToolTip="Move this stack up" AutomationProperties.Name="Move up"/>
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="▼" Command="{Binding MoveDownCommand}"
                                                    ToolTip="Move this stack down" AutomationProperties.Name="Move down"/>
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}"
                                                    ToolTip="Empty this slot" AutomationProperties.Name="Clear slot"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,0" MinWidth="72" Content="{Binding UpgradeText}"
                                                        IsEnabled="{Binding HasUpgrade}" ToolTip="{Binding UpgradeToolTip}" Click="UpgradeClicked"/>
                                                <local:CreatureSlotPicker HorizontalAlignment="Stretch"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock Text="Amount" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Width="Auto" Margin="8,0,0,0" HorizontalContentAlignment="Right"
                                                         IsEnabled="{Binding HasCreature}"
                                                         Text="{Binding CreatureAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- What the whole stack is worth, as the game works it out from one creature: label above value, in a row. -->
                                        <ItemsControl Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Facts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StackFact}">
                                                    <StackPanel MinWidth="84" Margin="0,0,16,2" ToolTip="{Binding ToolTip}">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Value}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <TextBlock Style="{StaticResource MutedTextStyle}" FontSize="11" Text="{Binding Label}"/>
                                                        <TextBlock TextWrapping="Wrap" Text="{Binding Value}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                                            <Setter Property="FontSize" Value="11"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Look up a creature, and put it in the army. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Find creatures"/>
                <wpf:FinderView DataContext="{Binding Finder}">
                    <wpf:FinderView.ToolbarContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="New stack of" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox Width="64" Margin="0" HorizontalContentAlignment="Right"
                                     Text="{Binding AddAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="How many creatures a stack you add starts with"/>
                        </StackPanel>
                    </wpf:FinderView.ToolbarContent>
                </wpf:FinderView>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
