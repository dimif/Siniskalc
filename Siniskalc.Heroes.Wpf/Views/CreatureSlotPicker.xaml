<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.CreatureSlotPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
             x:Name="root">
    <!-- A button that shows the creature of a stack. Clicking it opens a popup with a finder of creatures; picking a row puts it in the slot.
         DataContext is a StackSlotViewModel. -->
    <Grid>
        <Button x:Name="button" Height="26" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="8,3" Command="{Binding OpenPickerCommand}"
                AutomationProperties.Name="Creature" ToolTip="Click to pick a creature">
            <TextBlock Text="{Binding CreatureButtonText}" TextTrimming="CharacterEllipsis"/>
        </Button>
        <!-- Placement is custom so the popup keeps the side of the button it opened on while a search makes the list shorter. -->
        <Popup x:Name="popup" IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=button}" Placement="Custom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="PopupOpened" Closed="PopupClosed">
            <Border Width="{Binding PopupWidth, ElementName=root}"
                    Margin="0,2,8,8" Padding="10" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <wpf:FinderView DataContext="{Binding PickerFinder}" ListMaxHeight="320"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
