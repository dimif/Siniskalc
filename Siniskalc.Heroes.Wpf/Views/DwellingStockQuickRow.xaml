<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.DwellingStockQuickRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The data context is a DwellingStockActions: the buttons that fill every dwelling of a castle. -->
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
        <TextBlock Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" Text="Quick"/>
        <Button Style="{StaticResource PillButtonStyle}" Command="{Binding AddWeekToAllCommand}" Content="All +1 wk"
                ToolTip="Add a week of growth to every dwelling that is built"/>
        <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Command="{Binding AddHundredToAllCommand}" Content="All +100"
                ToolTip="Add 100 creatures to every dwelling that is built"/>
        <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Command="{Binding ClearAllCommand}" Content="All 0"
                ToolTip="Empty every dwelling"/>
    </StackPanel>
</UserControl>
