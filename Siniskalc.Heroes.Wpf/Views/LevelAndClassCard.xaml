<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.LevelAndClassCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <!-- The data context is a LevelAndClassCardViewModel. -->
    <Border Style="{StaticResource CardStyle}" Width="330">
        <StackPanel>
            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Level and class"/>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Level"/>
                <wpf:Stepper Grid.Column="1" Width="150" Value="{Binding Level}"
                             Minimum="{Binding LevelRange.Minimum}" Maximum="{Binding LevelRange.Maximum}" Step="{Binding LevelRange.Step}"/>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Experience"/>
                <wpf:Stepper Grid.Column="1" Width="150" Value="{Binding Experience}"
                             Minimum="{Binding ExperienceRange.Minimum}" Maximum="{Binding ExperienceRange.Maximum}" Step="{Binding ExperienceRange.Step}"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,3,0,0" Text="{Binding NextLevelNote}"/>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Class"/>
                <ComboBox Grid.Column="1" Width="150" HorizontalAlignment="Left" ItemsSource="{Binding Classes}" SelectedItem="{Binding HeroClass}" IsEnabled="{Binding CanChangeClass}"/>
            </Grid>
            <Grid Margin="0,3" Visibility="{Binding HasGender, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Gender"/>
                <ComboBox Grid.Column="1" Width="150" HorizontalAlignment="Left" ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
