<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.MapPointCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <!-- The data context is a MapPointCardViewModel: the position of a hero or its marker. -->
    <Border Style="{StaticResource CardStyle}" Width="330">
        <StackPanel>
            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Heading}"/>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="X"/>
                <wpf:Stepper Grid.Column="1" Width="110" ShowButtons="False" Value="{Binding X}"
                             Minimum="{Binding Coordinates.Minimum}" Maximum="{Binding Coordinates.Maximum}" Step="{Binding Coordinates.Step}"/>
            </Grid>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Y"/>
                <wpf:Stepper Grid.Column="1" Width="110" ShowButtons="False" Value="{Binding Y}"
                             Minimum="{Binding Coordinates.Minimum}" Maximum="{Binding Coordinates.Maximum}" Step="{Binding Coordinates.Step}"/>
            </Grid>
            <Grid Margin="0,3" Visibility="{Binding HasLevel, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Level (Z)"/>
                <ComboBox Grid.Column="1" Width="110" HorizontalAlignment="Left" ItemsSource="{Binding LevelChoices}"
                          DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Level}"/>
            </Grid>
            <Grid Margin="0,3" Visibility="{Binding HasFacing, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Facing"/>
                <ComboBox Grid.Column="1" Width="110" HorizontalAlignment="Left" ItemsSource="{Binding FacingChoices}" SelectedItem="{Binding Facing}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Width="28" Content="↺" FontSize="15" Padding="0,0,0,2" Command="{Binding RotateLeftCommand}" ToolTip="Rotate left (counter-clockwise)" AutomationProperties.Name="Rotate left"/>
                    <Button Width="28" Margin="4,0,0,0" Content="↻" FontSize="15" Padding="0,0,0,2" Command="{Binding RotateRightCommand}" ToolTip="Rotate right (clockwise)" AutomationProperties.Name="Rotate right"/>
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,6,0,0" Orientation="Horizontal" Visibility="{Binding HasSendToCastle, Converter={StaticResource BoolToVisibility}}">
                <Button x:Name="sendToggle" Style="{StaticResource PillButtonStyle}" Content="Send to castle ▾" Command="{Binding SendToCastle.OpenCommand}"
                        ToolTip="Move the hero to the entrance of a castle of its player"/>
                <Popup IsOpen="{Binding SendToCastle.IsOpen, Mode=TwoWay}" StaysOpen="False" PlacementTarget="{Binding ElementName=sendToggle}" Placement="Bottom" AllowsTransparency="True">
                    <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0" Width="300">
                        <StackPanel>
                            <TextBox x:Name="castleSearch" Text="{Binding SendToCastle.SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Type to search the castles by name"/>
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding SendToCastle.Castles}" MaxHeight="220">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="6,3" ToolTip="{Binding ToolTip}"
                                                Command="{Binding DataContext.SendToCastle.SendCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Content="{Binding Label}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <Button Margin="0,6,0,0" Padding="10,2" HorizontalAlignment="Left" Content="Remove" Command="{Binding RemoveCommand}" ToolTip="{Binding RemoveToolTip}"
                    Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>
    </Border>
</UserControl>
