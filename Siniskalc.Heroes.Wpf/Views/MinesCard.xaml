<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.MinesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Siniskalc.Heroes.Wpf.Views"
             xmlns:vm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels">
    <!-- The mines of the map: the headings that sort them and a row for each. The data context is a MinesListViewModel of the game's rows (each a
         MineRowViewModelBase): List (the headings and the rows in the order chosen) and SelectedMine. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate x:Key="MineRowTemplate" DataType="{x:Type vm:MineRowViewModelBase}">
            <Grid Margin="0,2" ToolTip="{Binding Kind}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ResourceName}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding X}" ToolTip="Column of the mine on the map"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Y}" ToolTip="Row of the mine on the map"/>
                <TextBlock Grid.Column="3" Width="120" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding LevelText}" ToolTip="Level of the map the mine is on"
                           Visibility="{Binding ShowLevel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                <ComboBox Grid.Column="4" HorizontalAlignment="Left" Width="110" ItemsSource="{Binding OwnerField.Choices}" SelectedItem="{Binding OwnerField.Selected}"
                          ToolTip="{Binding OwnerField.ToolTip}"/>
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Summary}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <views:ListCard Heading="Mines" Note="{Binding Note, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    ItemsSource="{Binding List.Items}" ItemTemplate="{StaticResource MineRowTemplate}" SelectedItem="{Binding SelectedMine, Mode=TwoWay}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Resource].Label}" Command="{Binding List.Columns[Resource].SortCommand}" ToolTip="Sort by resource"/>
            <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[X].Label}" Command="{Binding List.Columns[X].SortCommand}" ToolTip="Sort by X (X, then Y)"/>
            <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Y].Label}" Command="{Binding List.Columns[Y].SortCommand}" ToolTip="Sort by Y (Y, then X)"/>
            <TextBlock Grid.Column="3" Width="120" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Text="Level"
                       Visibility="{Binding ShowLevel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
            <Button Grid.Column="4" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Owner].Label}" Command="{Binding List.Columns[Owner].SortCommand}" ToolTip="Sort by owner"/>
            <TextBlock Grid.Column="5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{Binding SummaryHeading, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
    </views:ListCard>
</UserControl>
