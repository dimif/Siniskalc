<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.MinesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels">
    <!-- The mines of the map: the headings that sort them and a row for each. The data context is the page, which has MineList (a SortableListViewModel
         of MineRowViewModelBase), Mines and SelectedMine. -->
    <UserControl.Resources>
        <DataTemplate x:Key="MineRowTemplate" DataType="{x:Type vm:MineRowViewModelBase}">
            <Grid Margin="0,2" ToolTip="{Binding Kind}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ResourceName}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding X}" ToolTip="Column of the mine on the map"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Y}" ToolTip="Row of the mine on the map"/>
                <ComboBox Grid.Column="3" HorizontalAlignment="Left" Width="140" ItemsSource="{Binding OwnerField.Choices}" SelectedItem="{Binding OwnerField.Selected}"
                          ToolTip="{Binding OwnerField.ToolTip}"/>
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Summary}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
        <StackPanel>
            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Mines"/>
            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Note, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Resource].Label}" Command="{Binding MineList.Columns[Resource].SortCommand}" ToolTip="Sort by resource"/>
                <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[X].Label}" Command="{Binding MineList.Columns[X].SortCommand}" ToolTip="Sort by X (X, then Y)"/>
                <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Y].Label}" Command="{Binding MineList.Columns[Y].SortCommand}" ToolTip="Sort by Y (Y, then X)"/>
                <Button Grid.Column="3" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Owner].Label}" Command="{Binding MineList.Columns[Owner].SortCommand}" ToolTip="Sort by owner"/>
                <TextBlock Grid.Column="4" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="{Binding SummaryHeading, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            </Grid>
            <ListBox ItemsSource="{Binding Mines}" SelectedItem="{Binding SelectedMine}" ItemTemplate="{StaticResource MineRowTemplate}"
                     Margin="-1,0" BorderThickness="0" Padding="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                <!-- No padding around a row, and -1 for the pixel the template of the list keeps around it, or the columns would start to the right of the headings above them. -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>
