<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.MovementAndSpellPointsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <!-- The data context is a MovementAndSpellPointsCardViewModel. -->
    <Border Style="{StaticResource CardStyle}" Width="330">
        <StackPanel>
            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Movement &amp; Spell points"/>
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Movement"/>
                <wpf:Stepper Grid.Column="1" Width="60" ShowButtons="False" Value="{Binding CurrentMovement}"
                             Minimum="{Binding Movement.Minimum}" Maximum="{Binding Movement.Maximum}" Step="{Binding Movement.Step}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Padding="8,2" Content="Reset" Command="{Binding RestoreMovementCommand}"
                            ToolTip="Give the hero all of its movement points back"/>
                    <Button Margin="6,0,0,0" Padding="8,2" Content="Max" Command="{Binding MaxMovementCommand}"
                            ToolTip="Give the hero the most movement points that can be saved"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldNoteStyle}" Text="{Binding MaxMovementText}"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldNoteStyle}" Text="{Binding MovementNote}"/>
            </Grid>
            <ContentPresenter x:Name="extra" Margin="70,2,0,2"/>
            <Grid Margin="0,6,0,3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="70"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Spell"/>
                <wpf:Stepper Grid.Column="1" Width="60" ShowButtons="False" Value="{Binding CurrentSpellPoints}"
                             Minimum="{Binding SpellPoints.Minimum}" Maximum="{Binding SpellPoints.Maximum}" Step="{Binding SpellPoints.Step}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Padding="8,2" Content="Reset" Command="{Binding ResetSpellPointsCommand}"
                            Visibility="{Binding HasSpellPointsMaximum, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Fill the spell points up to the most this hero can have"/>
                    <Button Margin="6,0,0,0" Padding="8,2" Content="Max" Command="{Binding MaxSpellPointsCommand}"
                            ToolTip="Give the hero the most spell points that can be saved"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FieldNoteStyle}" Text="{Binding MaxSpellPointsText}"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
