<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.ObeliskVisitsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Siniskalc.Heroes.Wpf.Views"
             xmlns:vm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels">
    <!-- The data context is an ObeliskVisitsViewModelBase: the obelisks of the map and which of them the player has visited, in a list that sorts. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <DataTemplate x:Key="ObeliskRowTemplate" DataType="{x:Type vm:ObeliskRowViewModel}">
            <Grid Margin="0,2" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Label}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding X}" ToolTip="Column of the obelisk on the map"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Y}" ToolTip="Row of the obelisk on the map"/>
                <TextBlock Grid.Column="3" Width="120" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding LevelText}" ToolTip="Level of the map the obelisk is on"
                           Visibility="{Binding DataContext.ShowLevel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}"/>
                <ComboBox Grid.Column="4" HorizontalAlignment="Left" Width="80" ItemsSource="{x:Static vm:ObeliskRowViewModel.VisitedChoices}" SelectedItem="{Binding VisitedText}"
                          ToolTip="Whether this player has visited the obelisk"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <views:ListCard Heading="Visited obelisks" Summary="{Binding Summary}" ItemsSource="{Binding List.Items}" ItemTemplate="{StaticResource ObeliskRowTemplate}">
        <views:ListCard.Toolbar>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource PillButtonStyle}" Content="Visit all" Command="{Binding VisitAllCommand}" ToolTip="This player has visited every obelisk"/>
                <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Content="None" Command="{Binding ClearAllCommand}" ToolTip="This player has visited no obelisk"/>
            </StackPanel>
        </views:ListCard.Toolbar>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Obelisk].Label}" Command="{Binding List.Columns[Obelisk].SortCommand}" ToolTip="Sort by number"/>
            <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[X].Label}" Command="{Binding List.Columns[X].SortCommand}" ToolTip="Sort by X (X, then Y)"/>
            <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Y].Label}" Command="{Binding List.Columns[Y].SortCommand}" ToolTip="Sort by Y (Y, then X)"/>
            <Button Grid.Column="3" Width="120" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Level].Label}" Command="{Binding List.Columns[Level].SortCommand}" ToolTip="Sort by level"
                    Visibility="{Binding ShowLevel, Converter={StaticResource BoolToVisibility}}"/>
            <Button Grid.Column="4" Style="{StaticResource SortHeadingStyle}" Content="{Binding List.Columns[Visited].Label}" Command="{Binding List.Columns[Visited].SortCommand}" ToolTip="Sort by whether the player has visited the obelisk"/>
        </Grid>
    </views:ListCard>
</UserControl>
