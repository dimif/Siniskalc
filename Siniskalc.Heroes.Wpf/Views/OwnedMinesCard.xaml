<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.OwnedMinesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
             xmlns:views="clr-namespace:Siniskalc.Heroes.Wpf.Views">
    <!-- The mines of one owner, what the game shows of the one picked (Detail) and the bytes of it. The DataContext is an IOwnedMines that has
         Mines (a MinesListViewModel of the game's rows). -->
    <StackPanel>
        <views:MinesCard x:Name="minesCard" DataContext="{Binding Mines}"/>

        <ContentPresenter x:Name="detail"/>

        <!-- Hex: the bytes of the mine that is picked -->
        <Border x:Name="hexCard" Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Hex: the bytes of the mine that is picked"/>
                <wpf:HexEditor Grid.Row="1" x:Name="hexEditor" KnownFieldsHeight="120"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
