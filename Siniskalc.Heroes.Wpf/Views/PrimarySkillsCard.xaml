<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.PrimarySkillsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf">
    <!-- The data context is a PrimarySkillsCardViewModel. -->
    <Border Style="{StaticResource CardStyle}" Width="330">
        <StackPanel>
            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Primary skills"/>
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <!-- A PrimarySkillRowViewModel: the base the hero learned, the total with the artifacts and what they add. -->
                    <DataTemplate>
                        <Grid Margin="0,3">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}"/>
                            <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Base"/>
                            <wpf:Stepper Grid.Column="2" HorizontalAlignment="Stretch" Value="{Binding Base}" Minimum="{Binding Range.Minimum}" Maximum="{Binding Range.Maximum}" Step="{Binding Range.Step}"
                                         ToolTip="The skill the hero learned, without its artifacts"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource FieldNoteStyle}" Text="{Binding ArtifactNote}"/>
                            <TextBlock Grid.Column="3" Margin="12,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Total"/>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="The skill with its artifacts, as it counts in the game">
                                <TextBlock Style="{StaticResource TotalValueStyle}" Text="{Binding Total}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
