<UserControl x:Class="Siniskalc.Heroes.Wpf.Views.VisitedPlacesCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The data context is a VisitedPlacesCardViewModel. -->
    <Border Style="{StaticResource CardStyle}" Width="330">
        <StackPanel>
            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Title}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Style="{StaticResource PillButtonStyle}" Content="All none" Command="{Binding ForgetAllCommand}"
                        ToolTip="Forget every place: the hero can visit them all again. Not tried in the game."/>
                <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Content="All visited" Command="{Binding RememberAllCommand}"
                        ToolTip="Remember every place of the map: the hero has visited them all. Not tried in the game."/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Kinds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander Margin="0,2" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" ToolTip="{Binding ToolTip}">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="104" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Name}"/>
                                    <TextBlock Width="50" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text}"/>
                                    <Button Style="{StaticResource PillButtonStyle}" Content="None" Command="{Binding ForgetCommand}"
                                            ToolTip="Forget them all: the hero can visit them all again. Not tried in the game."/>
                                    <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Content="All" Command="{Binding RememberCommand}"
                                            ToolTip="Remember them all: the hero has visited every one on the map. Not tried in the game."/>
                                </StackPanel>
                            </Expander.Header>
                            <ItemsControl Margin="20,2,0,4" ItemsSource="{Binding Places}" ItemTemplate="{StaticResource ToggleRowTemplate}"/>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Others}" ItemTemplate="{StaticResource ToggleRowTemplate}"/>
        </StackPanel>
    </Border>
</UserControl>
