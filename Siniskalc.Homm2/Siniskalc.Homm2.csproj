<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Siniskalc.Homm2</AssemblyName>
    <RootNamespace>Siniskalc.Homm2</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Siniskalc.Core\Siniskalc.Core.csproj" />
    <ProjectReference Include="..\Siniskalc.Heroes\Siniskalc.Heroes.csproj" />
    <ProjectReference Include="..\Siniskalc.Heroes.Wpf\Siniskalc.Heroes.Wpf.csproj" />
    <ProjectReference Include="..\Siniskalc.Wpf\Siniskalc.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.globalconfig" Link=".globalconfig" />
    <None Remove="GameData\**\*.json" />
    <None Include="GameData\**\*.json" />
    <None Update="GameData\**\*.json" TargetPath="GameData\Homm2\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
