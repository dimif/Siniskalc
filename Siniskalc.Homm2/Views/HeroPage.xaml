<Page x:Class="Siniskalc.Homm2.Views.HeroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:local="clr-namespace:Siniskalc.Homm2.Views"
      Title="Hero">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4">
            <heroes:PageHeader ColorHex="{Binding ColorHex}" Title="{Binding Name}"
                               EditedToolTip="This hero has changes that are not saved yet"
                               ResetToolTip="Put everything of this hero back to what the savegame had">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding SubtitleText, Mode=OneWay}"
                               ToolTip="Faction, level and where the hero is on the map"/>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,3" VerticalAlignment="Bottom">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CastleName}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="· In " Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenCastleCommand}" Content="{Binding CastleName}"
                                FontSize="14" ToolTip="Go to castle"/>
                    </StackPanel>
                </StackPanel>
            </heroes:PageHeader>
            <heroes:OwnerPicker Margin="0,8,0,0"
                                PickerToolTip="Which player the hero belongs to. The hero is added to the list of heroes of its new owner and taken from the old one; a neutral hero has no move to finish."/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Text="{Binding Notice}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- The pages of a hero, as tabs. -->
        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="General"/>
            <wpf:NavButton Text="Skills"/>
            <wpf:NavButton Text="Creatures"/>
            <wpf:NavButton Text="Spells"/>
            <wpf:NavButton Text="Artifacts"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- Hex -->
        <wpf:HexEditor Grid.Row="2" x:Name="hexEditor" Margin="8,8,8,0" Style="{StaticResource TabPanel5}"/>

        <!-- The pages of cards scroll, except the hex tab, which has its own scrolling. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="5">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="8,4,8,16">
                <!-- General -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel0}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Primary skills"/>
                            <ItemsControl ItemsSource="{Binding PrimarySkills}" ItemTemplate="{StaticResource AmountFieldTemplate}"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="The game keeps the skills with the bonuses of the artifacts in them, and moves them with the artifact."/>
                        </StackPanel>
                    </Border>
                    <heroes:LevelAndClassCard DataContext="{Binding LevelAndClass}"/>
                    <heroes:MovementAndSpellPointsCard DataContext="{Binding MovementAndSpellPoints}"/>
                    <heroes:MapPointCard DataContext="{Binding Position}"/>
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Next battle"/>
                            <ItemsControl ItemsSource="{Binding BattleBonus}" ItemTemplate="{StaticResource AmountFieldTemplate}"/>
                            <TextBlock Margin="0,8,0,2" Foreground="{StaticResource MutedBrush}" Text="Given by"/>
                            <ItemsControl ItemsSource="{Binding BattleSources}" ItemTemplate="{StaticResource ToggleRowTemplate}"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="What a temple, a fountain, a faerie ring or a graveyard gave. The game takes it away after the next battle. Not tried in the game."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Places visited"/>
                            <ItemsControl ItemsSource="{Binding VisitedPlaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Expander Margin="0,2" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" ToolTip="{Binding ToolTip}">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Width="116" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Name}"/>
                                                    <TextBlock Width="50" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Text}"/>
                                                    <Button Style="{StaticResource PillButtonStyle}" Content="Forget all" Command="{Binding ForgetCommand}"
                                                            ToolTip="The hero can visit them all again. Not tried in the game."/>
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl Margin="20,2,0,4" ItemsSource="{Binding Places}" ItemTemplate="{StaticResource ToggleRowTemplate}"/>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding UsedOnce}" ItemTemplate="{StaticResource ToggleRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <!-- Last, so that it is not stretched to the height of the tall card beside it. -->
                    <heroes:MapPointCard DataContext="{Binding Destination}"/>
                </WrapPanel>

                <!-- Skills -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel1}">
                    <wpf:SecondarySkillsView DataContext="{Binding SkillsEditor}"/>
                </StackPanel>

                <!-- Creatures -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <wpf:ArmyEditorView DataContext="{Binding ArmyEditor}"/>
                </StackPanel>

                <!-- Spells -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel3}">
                    <wpf:SpellsView DataContext="{Binding SpellsEditor}" Height="560"/>
                </StackPanel>

                <!-- Artifacts -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel4}">
                    <local:ArtifactsView DataContext="{Binding ArtifactsEditor}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
