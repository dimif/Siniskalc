<Page x:Class="Siniskalc.Homm2.Views.Homm2CastlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:vm="clr-namespace:Siniskalc.Homm2.ViewModels"
      Title="Castle">
    <Page.Resources>
        <!-- A dwelling: the box that says it is built, and how many creatures wait in it. -->
        <DataTemplate x:Key="DwellingTemplate" DataType="{x:Type vm:Homm2DwellingRowViewModel}">
            <DockPanel Margin="0,3">
                <wpf:Stepper DockPanel.Dock="Right" Width="130" VerticalAlignment="Top" IsEnabled="{Binding Built.IsChecked}"
                             Value="{Binding Waiting.Value}" Minimum="{Binding Waiting.Minimum}" Maximum="{Binding Waiting.Maximum}" Step="{Binding Waiting.Step}"
                             ToolTip="How many creatures wait in the dwelling"/>
                <ContentControl Content="{Binding Built}" ContentTemplate="{StaticResource ToggleRowTemplate}"/>
            </DockPanel>
        </DataTemplate>

        <!-- A level of the Mage Guild: its spells. -->
        <DataTemplate x:Key="GuildLevelTemplate" DataType="{x:Type vm:Homm2GuildLevelViewModel}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Margin="0,4,0,2" FontWeight="SemiBold" Text="{Binding Heading}"/>
                <ItemsControl ItemsSource="{Binding Spells}" ItemTemplate="{StaticResource ChoiceFieldTemplate}"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4" Orientation="Horizontal">
            <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14">
                <Run Text="{Binding RaceName, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding KindText, Mode=OneWay}"/>
            </TextBlock>
            <Border Style="{StaticResource Homm2EditedMarkStyle}" ToolTip="This castle has changes that are not saved yet">
                <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button Style="{StaticResource Homm2ResetPillStyle}" Content="Reset" Command="{Binding ResetCommand}"
                    ToolTip="Put everything of this castle back to what the savegame had"/>
        </StackPanel>

        <!-- The pages of a castle, as tabs. -->
        <ListBox Grid.Row="1" SelectionMode="Single" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                 Margin="16,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <wpf:NavButton Text="General"/>
            <wpf:NavButton Text="Buildings"/>
            <wpf:NavButton Text="Creatures"/>
            <wpf:NavButton Text="Mage Guild"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- Hex -->
        <wpf:HexEditor Grid.Row="2" x:Name="hexEditor" Margin="8,8,8,0" Style="{StaticResource Homm2TabPanel4}"/>

        <!-- The pages of cards scroll, except the hex tab, which has its own scrolling. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="4">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="8,4,8,16">
                <!-- General -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel0}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Castle"/>
                            <ContentControl Content="{Binding OwnerField}" ContentTemplate="{StaticResource ChoiceFieldTemplate}"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Text="{Binding Notice}"/>
                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VisitingHeroName}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Width="130" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="Hero inside"/>
                                <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenHeroCommand}" Content="{Binding VisitingHeroName}" ToolTip="Go to hero"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Buildings -->
                <StackPanel Style="{StaticResource Homm2TabPanel1}">
                    <WrapPanel Margin="-6,0,0,0">
                        <Border Style="{StaticResource CardStyle}" Width="330">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Buildings"/>
                                <ItemsControl ItemsSource="{Binding Buildings}" ItemTemplate="{StaticResource ToggleRowTemplate}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Width="420">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Dwellings and the creatures that wait in them"/>
                                <ItemsControl ItemsSource="{Binding Dwellings}" ItemTemplate="{StaticResource DwellingTemplate}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                               Text="The editor does not check what the game needs before a building can be built: a town needs its castle first. The upgrades of the dwellings and the Mage Guild above level 2 are not decoded yet."/>
                </StackPanel>

                <!-- Creatures -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel2}">
                    <wpf:ArmyEditorView DataContext="{Binding GarrisonEditor}"/>
                </StackPanel>

                <!-- Mage Guild -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel3}">
                    <Border Style="{StaticResource CardStyle}" Width="400">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Mage Guild"/>
                            <ContentControl Content="{Binding GuildLevelField}" ContentTemplate="{StaticResource ChoiceFieldTemplate}"/>
                            <ItemsControl ItemsSource="{Binding GuildLevels}" ItemTemplate="{StaticResource GuildLevelTemplate}"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                                       Text="The guild teaches the spells of the levels it has built. The fourth spell of a level has not been seen in the game."/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
