<Page x:Class="Siniskalc.Homm2.Views.Homm2HeroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      Title="Hero">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14">
                    <Run Text="{Binding RaceName, Mode=OneWay}"/><Run Text=", level "/><Run Text="{Binding Level, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding PositionText, Mode=OneWay}"
                           ToolTip="Where the hero is on the map" Style="{StaticResource FieldNoteStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,3" VerticalAlignment="Bottom">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CastleName}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="· In " Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenCastleCommand}" Content="{Binding CastleName}"
                            FontSize="14" ToolTip="Go to castle"/>
                </StackPanel>
                <Border Style="{StaticResource Homm2EditedMarkStyle}" ToolTip="This hero has changes that are not saved yet">
                    <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                </Border>
                <Button Style="{StaticResource Homm2ResetPillStyle}" Content="Reset" Command="{Binding ResetCommand}"
                        ToolTip="Put everything of this hero back to what the savegame had"/>
            </StackPanel>
        </StackPanel>

        <!-- The pages of a hero, as tabs. -->
        <ListBox Grid.Row="1" SelectionMode="Single" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                 Margin="16,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <wpf:NavButton Text="General"/>
            <wpf:NavButton Text="Skills"/>
            <wpf:NavButton Text="Creatures"/>
            <wpf:NavButton Text="Spells"/>
            <wpf:NavButton Text="Artifacts"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- General -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel0}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Primary skills"/>
                            <ItemsControl ItemsSource="{Binding PrimarySkills}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Hero"/>
                            <ItemsControl ItemsSource="{Binding Facts}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,3">
                                <TextBlock Width="130" Foreground="{StaticResource MutedBrush}" Text="Serves"/>
                                <TextBlock FontWeight="SemiBold" Text="{Binding OwnerText}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Skills -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel1}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Secondary skills"/>
                            <ItemsControl ItemsSource="{Binding Skills}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                            <TextBlock Style="{StaticResource Homm2EmptyNoteStyle}" Tag="{Binding HasSkills}" Text="This hero has no secondary skills"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Creatures -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel2}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Army"/>
                            <ItemsControl ItemsSource="{Binding Army}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Spells -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel3}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Spell book"/>
                            <ItemsControl ItemsSource="{Binding Spells}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                            <TextBlock Style="{StaticResource Homm2EmptyNoteStyle}" Tag="{Binding HasSpells}" Text="This hero knows no spells"/>
                            <TextBlock Style="{StaticResource Homm2EmptyNoteStyle}" Tag="{Binding HasSpellBook}" Text="The hero has no Magic Book, so it cannot cast spells"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Artifacts -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel4}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Artifacts"/>
                            <ItemsControl ItemsSource="{Binding Artifacts}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                            <TextBlock Style="{StaticResource Homm2EmptyNoteStyle}" Tag="{Binding HasArtifacts}" Text="This hero carries no artifacts"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
