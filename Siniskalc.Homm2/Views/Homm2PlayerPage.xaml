<Page x:Class="Siniskalc.Homm2.Views.Homm2PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:vm="clr-namespace:Siniskalc.Homm2.ViewModels"
      Title="Player">
    <Page.Resources>
        <!-- A resource card: its name, the amount and what the player earns each day. -->
        <DataTemplate x:Key="ResourceTemplate" DataType="{x:Type vm:Homm2FactRow}">
            <Border Style="{StaticResource CardStyle}" Width="210">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding Label}"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource TotalValueStyle}" Text="{Binding Value}"/>
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource FieldNoteStyle}" Foreground="{StaticResource AccentBrush}" Text="{Binding Note}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4" Orientation="Horizontal">
            <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}" FontSize="14" Text="{Binding Status}"/>
            <Border Style="{StaticResource Homm2EditedMarkStyle}" ToolTip="This player has changes that are not saved yet">
                <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button Style="{StaticResource Homm2ResetPillStyle}" Content="Reset" Command="{Binding ResetCommand}"
                    ToolTip="Put everything of this player back to what the savegame had"/>
        </StackPanel>

        <!-- The pages of a player, as tabs. -->
        <ListBox Grid.Row="1" SelectionMode="Single" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                 Margin="16,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <wpf:NavButton Text="Resources"/>
            <wpf:NavButton Text="Heroes"/>
            <wpf:NavButton Text="Towns"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- Resources -->
                <StackPanel Style="{StaticResource Homm2TabPanel0}">
                    <ItemsControl Margin="-6,12,0,0" ItemsSource="{Binding Resources}" ItemTemplate="{StaticResource ResourceTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- Heroes -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel1}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Heroes"/>
                            <ItemsControl ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource Homm2LinkTemplate}"/>
                            <TextBlock Style="{StaticResource Homm2EmptyNoteStyle}" Tag="{Binding HasHeroes}" Text="This player has no heroes"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Tavern"/>
                            <ItemsControl ItemsSource="{Binding Tavern}" ItemTemplate="{StaticResource Homm2FactRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Towns -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource Homm2TabPanel2}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Towns"/>
                            <ItemsControl ItemsSource="{Binding Castles}" ItemTemplate="{StaticResource Homm2LinkTemplate}"/>
                            <TextBlock Style="{StaticResource Homm2EmptyNoteStyle}" Tag="{Binding HasCastles}" Text="This player has no towns"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
