<Page x:Class="Siniskalc.Homm2.Views.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:wpfvm="clr-namespace:Siniskalc.Wpf.ViewModels;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:vm="clr-namespace:Siniskalc.Homm2.ViewModels"
      Title="Map">
    <Page.Resources>
        <!-- A mine: what it gives, where it is, and its owner. -->
        <DataTemplate x:Key="MineTemplate" DataType="{x:Type vm:MineRowViewModel}">
            <Grid Margin="0,2" ToolTip="{Binding Kind}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ResourceName}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding X}" ToolTip="Column of the mine on the map"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Y}" ToolTip="Row of the mine on the map"/>
                <ComboBox Grid.Column="3" HorizontalAlignment="Left" Width="140" ItemsSource="{Binding OwnerField.Choices}" SelectedItem="{Binding OwnerField.Selected}" ToolTip="{Binding OwnerField.ToolTip}"/>
            </Grid>
        </DataTemplate>

        <!-- A shrine: its circle, where it is, and the spell it teaches. -->
        <DataTemplate x:Key="ShrineTemplate" DataType="{x:Type vm:ShrineRowViewModel}">
            <StackPanel Margin="0,2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Circle}"/>
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding X}" ToolTip="Column of the shrine on the map"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Y}" ToolTip="Row of the shrine on the map"/>
                    <ComboBox Grid.Column="3" HorizontalAlignment="Left" Width="200" ItemsSource="{Binding SpellField.Choices}" SelectedItem="{Binding SpellField.Selected}"
                              IsEnabled="{Binding SpellField.IsEnabled}" ToolTip="{Binding SpellField.ToolTip}"/>
                </Grid>
                <TextBlock Margin="210,0,0,0" TextWrapping="Wrap" Text="{Binding Note}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNote}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- The heading of a sortable column: a flat button with the name and the arrow. -->
        <Style x:Key="SortHeadingStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A text the user types: an answer or a riddle. -->
        <DataTemplate x:Key="TextFieldTemplate" DataType="{x:Type wpfvm:TextFieldViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Top" Margin="0,4,0,0" Text="{Binding Label}"/>
                <StackPanel Grid.Column="1">
                    <TextBox MaxLength="{Binding MaxLength}" TextWrapping="Wrap" ToolTip="{Binding ToolTip}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="AcceptsReturn" Value="False"/>
                                <Setter Property="MinHeight" Value="26"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMultiline}" Value="True">
                                        <Setter Property="MinHeight" Value="110"/>
                                        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" Text="{Binding Counter}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- A sphinx: whether it can be answered, the reward, the answers and the riddle. -->
        <DataTemplate x:Key="SphinxTemplate" DataType="{x:Type vm:SphinxViewModel}">
            <WrapPanel>
                <Border Style="{StaticResource CardStyle}" Width="380">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Title}"/>
                        <ContentControl Content="{Binding SolvedToggle}" ContentTemplate="{StaticResource ToggleRowTemplate}"/>
                        <TextBlock Margin="0,8,0,2" Foreground="{StaticResource MutedBrush}" Text="An answer gives"/>
                        <ItemsControl ItemsSource="{Binding Reward}" ItemTemplate="{StaticResource AmountFieldTemplate}"/>
                        <ContentControl Content="{Binding ArtifactPicker}" ContentTemplate="{StaticResource ArtifactSlotRowTemplate}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="500">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Riddle and answers"/>
                        <ContentControl Content="{Binding Riddle}" ContentTemplate="{StaticResource TextFieldTemplate}"/>
                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Answers}" ItemTemplate="{StaticResource TextFieldTemplate}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <heroes:PageHeader Grid.Row="0" Margin="16,14,16,4" ColorHex="#9AA3AE" Title="Map"
                           EditedToolTip="The mines, shrines or sphinxes have changes that are not saved yet"
                           ResetToolTip="Put every mine, shrine and sphinx back to what the savegame had">
            <TextBlock Margin="12,0,0,3" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding MinesSummary}"/>
        </heroes:PageHeader>

        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="Mines"/>
            <wpf:NavButton Text="Shrines"/>
            <wpf:NavButton Text="Sphinxes"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- Mines -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel0}">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Mines"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Who owns each mine on the map."/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Resource].Label}" Command="{Binding MineList.Columns[Resource].SortCommand}" ToolTip="Sort by resource"/>
                                <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[X].Label}" Command="{Binding MineList.Columns[X].SortCommand}" ToolTip="Sort by X (X, then Y)"/>
                                <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Y].Label}" Command="{Binding MineList.Columns[Y].SortCommand}" ToolTip="Sort by Y (Y, then X)"/>
                                <Button Grid.Column="3" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Owner].Label}" Command="{Binding MineList.Columns[Owner].SortCommand}" ToolTip="Sort by owner"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding MineList.Items}" ItemTemplate="{StaticResource MineTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Shrines -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel1}">
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Shrines"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Spells taught in the shrines. Not yet tested."/>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding ShrineList.Columns[Name].Label}" Command="{Binding ShrineList.Columns[Name].SortCommand}" ToolTip="Sort by circle"/>
                                <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding ShrineList.Columns[X].Label}" Command="{Binding ShrineList.Columns[X].SortCommand}" ToolTip="Sort by X (X, then Y)"/>
                                <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding ShrineList.Columns[Y].Label}" Command="{Binding ShrineList.Columns[Y].SortCommand}" ToolTip="Sort by Y (Y, then X)"/>
                                <Button Grid.Column="3" Style="{StaticResource SortHeadingStyle}" Content="{Binding ShrineList.Columns[Spell].Label}" Command="{Binding ShrineList.Columns[Spell].SortCommand}" ToolTip="Sort by spell"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ShrineList.Items}" ItemTemplate="{StaticResource ShrineTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Sphinxes -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <ItemsControl ItemsSource="{Binding Sphinxes}" ItemTemplate="{StaticResource SphinxTemplate}"/>
                    <TextBlock Margin="6,8,0,0" Text="This map has no sphinx.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSphinxes}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
