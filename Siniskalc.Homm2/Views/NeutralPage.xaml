<Page x:Class="Siniskalc.Homm2.Views.NeutralPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:local="clr-namespace:Siniskalc.Homm2.Views"
      Title="Neutral">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityTab"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <heroes:PageHeader Grid.Row="0" Margin="16,14,16,4" ColorHex="{Binding ColorHex}" Title="{Binding Name}">
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding Summary}"/>
        </heroes:PageHeader>

        <!-- What nobody owns, as tabs. A HoMM2 map has no dwellings of its own. -->
        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="Heroes"/>
            <wpf:NavButton Text="Towns"/>
            <wpf:NavButton Text="Mines" Visibility="{Binding Mines.HasMines, Converter={StaticResource BoolToVisibilityTab}}"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- Heroes -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel0}">
                    <heroes:ItemsCard Heading="Heroes" ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource LinkTemplate}"
                                      HasItems="{Binding HasHeroes}" EmptyText="Every hero is owned by a player"/>
                </WrapPanel>

                <!-- Towns -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel1}">
                    <heroes:ItemsCard Heading="Towns" ItemsSource="{Binding Castles}" ItemTemplate="{StaticResource CastleLinkTemplate}"
                                      HasItems="{Binding HasCastles}" EmptyText="Every town is owned by a player"/>
                </WrapPanel>

                <!-- Mines -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <heroes:OwnedMinesCard Note="Who owns each mine nobody owns." SummaryHeading="Guard (read-only)"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
