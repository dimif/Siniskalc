<Page x:Class="Siniskalc.Homm2.Views.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:vm="clr-namespace:Siniskalc.Homm2.ViewModels"
      Title="Overview">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16,14,16,16">
            <TextBlock Text="{Binding MapName}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource MutedBrush}" FontSize="14">
                <Run Text="{Binding Version, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding MapSize, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Date, Mode=OneWay}"/>
            </TextBlock>

            <WrapPanel Margin="-6,12,0,0">
                <Border Style="{StaticResource CardStyle}" Width="330">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Scenario"/>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Width="330">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Players"/>
                        <ItemsControl ItemsSource="{Binding Players}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PlayerSummary}">
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                                        <StackPanel Grid.Column="1">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Holdings}"/>
                                                <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.OpenPlayerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                        CommandParameter="{Binding Color}" Content="{Binding Name}" ToolTip="Go to player"/>
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource FieldNoteStyle}" Text="{Binding Gold, StringFormat='{}{0:N0} gold'}"/>
                                            <TextBlock Style="{StaticResource FieldNoteStyle}" Foreground="{StaticResource AccentBrush}" Text="{Binding Status}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
