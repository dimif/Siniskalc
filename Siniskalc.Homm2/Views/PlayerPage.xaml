<Page x:Class="Siniskalc.Homm2.Views.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      Title="Player">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <heroes:PageHeader Grid.Row="0" Margin="16,14,16,4" ColorHex="{Binding ColorHex}" Title="{Binding Name}"
                           EditedToolTip="This player has changes that are not saved yet"
                           ResetToolTip="Put everything of this player back to what the savegame had">
            <TextBlock Margin="12,0,0,3" Foreground="{StaticResource AccentBrush}" FontSize="14" Text="{Binding Status}"/>
        </heroes:PageHeader>

        <!-- The pages of a player, as tabs. -->
        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="Resources"/>
            <wpf:NavButton Text="Heroes"/>
            <wpf:NavButton Text="Towns"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- Hex -->
        <wpf:HexEditor Grid.Row="2" x:Name="hexEditor" Margin="8,8,8,0" Style="{StaticResource TabPanel3}"/>

        <!-- The pages of cards scroll, except the hex tab, which has its own scrolling. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTab}" Value="3">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <Grid Margin="8,4,8,16">
                <!-- Resources -->
                <Grid Style="{StaticResource TabPanel0}">
                    <heroes:ResourcesPanel Note="Amounts are limited to 999,999 gold and 9,999 of each other resource. Hold Shift while pressing + or − to step by ten. The income is worked out by the game at the start of each day."/>
                </Grid>

                <!-- Heroes -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel1}">
                    <heroes:ItemsCard Heading="Heroes" ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource LinkTemplate}"
                                      HasItems="{Binding HasHeroes}" EmptyText="This player has no heroes"/>
                    <heroes:TavernCard ItemsSource="{Binding TavernPlaces}"/>
                </WrapPanel>

                <!-- Towns -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <heroes:ItemsCard Heading="Towns" ItemsSource="{Binding Castles}" ItemTemplate="{StaticResource LinkTemplate}"
                                      HasItems="{Binding HasCastles}" EmptyText="This player has no towns"/>
                </WrapPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
