{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HoMM3 artifacts",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "order": {
        "type": "integer",
        "minimum": 0
      },
      "name": {
        "type": "string"
      },
      "code": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "availableFrom": {
        "type": "string",
        "enum": [
          "restorationOfErathia",
          "armageddonsBlade",
          "shadowOfDeath",
          "heroesChronicles",
          "hornOfTheAbyss"
        ]
      },
      "slot": {
        "type": "string"
      },
      "blockedSlots": {
        "type": "string"
      },
      "effectInfo": {
        "type": "object",
        "properties": {
          "atk": {
            "type": "integer"
          },
          "def": {
            "type": "integer"
          },
          "pow": {
            "type": "integer"
          },
          "kno": {
            "type": "integer"
          },
          "luck": {
            "type": "integer"
          },
          "morale": {
            "type": "integer"
          },
          "landMovement": {
            "type": "integer"
          },
          "waterMovement": {
            "type": "integer"
          },
          "spellGrants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "spells": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "description": {
                  "type": "string"
                },
                "school": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "level": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "spells",
                "description",
                "school",
                "level"
              ],
              "additionalProperties": false
            }
          },
          "grantsSpellBook": {
            "type": "boolean"
          },
          "gold": {
            "type": "integer"
          },
          "ore": {
            "type": "integer"
          },
          "wood": {
            "type": "integer"
          },
          "crystal": {
            "type": "integer"
          },
          "gems": {
            "type": "integer"
          },
          "mercury": {
            "type": "integer"
          },
          "sulfur": {
            "type": "integer"
          },
          "other": {
            "type": "string"
          }
        },
        "required": [
          "atk",
          "def",
          "pow",
          "kno",
          "luck",
          "morale",
          "landMovement",
          "waterMovement",
          "spellGrants",
          "grantsSpellBook",
          "gold",
          "ore",
          "wood",
          "crystal",
          "gems",
          "mercury",
          "sulfur",
          "other"
        ],
        "additionalProperties": false
      },
      "description": {
        "type": "string"
      },
      "isCombination": {
        "type": "boolean"
      },
      "class": {
        "type": "string",
        "enum": [
          "major",
          "minor",
          "relic",
          "special",
          "treasure"
        ]
      },
      "cost": {
        "type": "integer"
      },
      "combinesInto": {
        "type": [
          "string",
          "null"
        ]
      },
      "role": {
        "type": "string",
        "enum": [
          "fallback",
          "none",
          "scroll",
          "spellBook"
        ]
      },
      "wearable": {
        "type": "boolean"
      },
      "backpack": {
        "type": "boolean"
      },
      "replaces": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "order",
      "name",
      "code",
      "availableFrom",
      "slot",
      "blockedSlots",
      "effectInfo",
      "description",
      "isCombination",
      "class",
      "cost",
      "combinesInto",
      "role",
      "wearable",
      "backpack"
    ],
    "additionalProperties": false
  }
}
