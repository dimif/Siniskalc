{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HoMM3 heroClasses",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "code": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "availableFrom": {
        "type": "string",
        "enum": [
          "roe",
          "ab",
          "sod",
          "chronicles",
          "hota"
        ]
      },
      "faction": {
        "type": [
          "string",
          "null"
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "magic",
          "might"
        ]
      },
      "replaces": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "name",
      "code",
      "availableFrom",
      "faction",
      "type"
    ],
    "additionalProperties": false
  }
}
