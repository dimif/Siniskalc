<Page x:Class="Siniskalc.Homm3.Views.CastlePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Homm3.Views"
      xmlns:vm="clr-namespace:Siniskalc.Homm3.ViewModels"
      xmlns:wvm="clr-namespace:Siniskalc.Heroes.Wpf.ViewModels;assembly=Siniskalc.Heroes.Wpf"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CastlePage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- The pages of cards scroll, except the hex tab, which has its own scrolling. -->
        <Style x:Key="CardsScrollerStyle" TargetType="ScrollViewer">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="5">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A hero in the castle, on the title row: its role, and its name, which opens the hero. -->
        <DataTemplate x:Key="CastleHeroTemplate" DataType="{x:Type wvm:CastleHeroRowViewModel}">
            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Bottom">
                <TextBlock VerticalAlignment="Bottom" FontSize="14" Foreground="{StaticResource MutedBrush}" Text="{Binding Role, StringFormat={}{0}:}"/>
                <Button Style="{StaticResource LinkButtonStyle}" Margin="6,0,0,0" VerticalAlignment="Bottom" FontSize="14" Command="{Binding OpenCommand}" Content="{Binding Name}"
                        ToolTip="Open this hero"/>
            </StackPanel>
        </DataTemplate>

        <!-- A creature level: the dwelling that serves it with its state, and the creatures waiting in it on the right. -->
        <DataTemplate x:Key="DwellingRowTemplate" DataType="{x:Type vm:DwellingRowViewModel}">
            <DockPanel Margin="0,3">
                <Button DockPanel.Dock="Right" Style="{StaticResource PillButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center" Content="+1 wk" Command="{Binding AddWeekCommand}"
                        ToolTip="Add a week of growth to the dwelling"/>
                <wpf:Stepper DockPanel.Dock="Right" Width="130" Margin="12,0,0,0" VerticalAlignment="Center" Value="{Binding Count}" Minimum="0" Maximum="{Binding Maximum}"
                               ToolTip="How many creatures wait in this dwelling">
                    <wpf:Stepper.Style>
                        <Style TargetType="wpf:Stepper">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanEdit}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </wpf:Stepper.Style>
                </wpf:Stepper>
                <TextBlock DockPanel.Dock="Right" Width="80" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding WeeklyGrowthText}"
                           ToolTip="The weekly growth of the creature. The bonuses of the castle, the horde building and the Grail are not included."/>
                <TextBlock DockPanel.Dock="Left" Width="22" Foreground="{StaticResource MutedBrush}" Text="{Binding Level}"/>
                <StackPanel>
                    <TextBlock x:Name="dwelling" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Text="{Binding CreatureNames}"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0" Text="{Binding State}"/>
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBuilt}" Value="True">
                    <Setter TargetName="dwelling" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Setter TargetName="dwelling" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A spell level of the mage guild and how many spells it holds. -->
        <DataTemplate x:Key="MageGuildLevelTemplate" DataType="{x:Type vm:MageGuildLevelRowViewModel}">
            <StackPanel Margin="0,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" x:Name="spells" Foreground="{StaticResource MutedBrush}" Text="{Binding SpellsText}"/>
                    <TextBlock x:Name="level" Foreground="{StaticResource MutedBrush}" Text="{Binding Level, StringFormat='Level {0}'}"/>
                </DockPanel>
                <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Slots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MageGuildSpellSlotViewModel}">
                            <ComboBox Margin="0,0,6,4" MinWidth="130" FontSize="11" ItemsSource="{Binding Choices}" DisplayMemberPath="Name" SelectedItem="{Binding Spell}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBuilt}" Value="True">
                    <Setter TargetName="level" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Setter TargetName="level" Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="spells" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A building: a tick when it is built, its name, and under it what it needs or a note when that is missing. -->
        <DataTemplate x:Key="BuildingRowTemplate" DataType="{x:Type vm:BuildingRowViewModel}">
            <DockPanel Margin="0,3" x:Name="row">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                <Setter Property="Margin" Value="22,3,0,3"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Creatures}"/>
                <Button DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Top" Command="{Binding ToggleAllowedCommand}"
                        Content="{Binding AllowText}" ToolTip="{Binding AllowToolTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CanSetAllowed}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <CheckBox DockPanel.Dock="Left" Width="24" Margin="0,2,0,0" VerticalAlignment="Top" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanToggle}"
                          ToolTip="{Binding ToggleToolTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name}"/>
                <StackPanel>
                    <TextBlock x:Name="name" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}" Text="{Binding Name}"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,0,0" TextWrapping="Wrap" Text="{Binding Requirements}"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Text="{Binding Warning}"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Text="{Binding Note}"/>
                </StackPanel>
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                    <Setter TargetName="row" Property="Opacity" Value="0.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBuilt}" Value="True">
                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                    <Setter TargetName="name" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="BuildingGroupTemplate" DataType="{x:Type vm:BuildingGroupViewModel}">
            <heroes:HeadedCard Heading="{Binding Title}" Summary="{Binding Summary}">
                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource BuildingRowTemplate}"/>
            </heroes:HeadedCard>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4">
            <heroes:PageHeader ColorHex="{Binding ColorHex}" Title="{Binding Name}"
                               EditedToolTip="This town has changes that are not saved yet"
                               ResetToolTip="Put everything in this town (owner, garrison, buildings, creatures and Mage Guild) back to what the savegame had">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14">
                        <Run Text="{Binding FactionText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding OwnerText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PositionText, Mode=OneWay}"/>
                    </TextBlock>
                    <!-- The heroes in the castle, read only: moving a hero in or out of a castle changes the hero, the player and the castle together. -->
                    <ItemsControl Margin="24,0,0,3" VerticalAlignment="Bottom" ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource CastleHeroTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </heroes:PageHeader>
            <TextBlock Margin="0,4,0,0" Style="{StaticResource FieldNoteStyle}">
                <Run Text="{Binding StatusText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ShipyardText, Mode=OneWay}"/>
            </TextBlock>
            <heroes:OwnerPicker Margin="0,8,0,0" PickerToolTip="Who owns the town"/>
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" Text="{Binding Notice}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNotice}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- The pages of a castle, as tabs. -->
        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" x:Name="tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="Buildings"/>
            <wpf:NavButton Text="Garrison"/>
            <wpf:NavButton Text="Available creatures"/>
            <wpf:NavButton Text="Mage guild"/>
            <wpf:NavButton Text="Artifact merchant" Visibility="{Binding HasArtifactMerchant, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- Hex -->
        <wpf:HexEditor Grid.Row="2" x:Name="hexEditor" Margin="8,8,8,0" Style="{StaticResource TabPanel5}"/>

        <ScrollViewer Grid.Row="2" Style="{StaticResource CardsScrollerStyle}" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- Buildings -->
                <StackPanel Style="{StaticResource TabPanel0}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox VerticalAlignment="Center" Content="Can build this turn" IsChecked="{Binding CanBuildThisTurn}"
                                  ToolTip="Whether a building can still be built in this town today. The game allows one building per town per day."/>
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldNoteStyle}" Text="{Binding BuildingsSummary}"/>
                    </StackPanel>
                    <ItemsControl Margin="-6,0,0,0" ItemsSource="{Binding BuildingGroups}" ItemTemplate="{StaticResource BuildingGroupTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                               Text="Buildings not allowed by the map are marked and dimmed."/>
                </StackPanel>

                <!-- Garrison: the same army editor as the creatures of a hero. -->
                <StackPanel Style="{StaticResource TabPanel1}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding HasGarrisonedHero, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" Command="{Binding OpenGarrisonedHeroCommand}"
                                Content="{Binding GarrisonedHeroName}" ToolTip="Open this hero"/>
                        <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource FieldNoteStyle}" Text="is garrisoned here"/>
                    </StackPanel>
                    <local:ArmyEditor DataContext="{Binding GarrisonEditor}"/>
                </StackPanel>

                <!-- Available creatures -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <heroes:HeadedCard Heading="Available creatures" Summary="{Binding DwellingsSummary}" CardWidth="672">
                        <StackPanel>
                            <heroes:DwellingStockQuickRow DataContext="{Binding DwellingActions}"/>
                            <ItemsControl ItemsSource="{Binding Dwellings}" ItemTemplate="{StaticResource DwellingRowTemplate}"/>
                        </StackPanel>
                    </heroes:HeadedCard>
                </WrapPanel>

                <!-- Mage guild -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel3}">
                    <heroes:HeadedCard Heading="Mage guild" Summary="{Binding MageGuildSummary}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Level" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
                                <ComboBox Width="80" Margin="8,0,0,0" HorizontalAlignment="Left" ItemsSource="{Binding MageGuildLevelChoices}" SelectedItem="{Binding SelectedMageGuildLevel}"
                                          ToolTip="Builds the Mage Guild up to this level, or removes the levels above it"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding MageGuildLevels}" ItemTemplate="{StaticResource MageGuildLevelTemplate}"/>
                        </StackPanel>
                    </heroes:HeadedCard>
                </WrapPanel>

                <StackPanel Style="{StaticResource TabPanel4}">
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                               Text="This stock is shared by all town Artifact Merchants, regardless of owner. Changes here affect every town, not the adventure-map Black Markets. Editor-written stock has not yet been tried in the game."/>
                    <Border Style="{StaticResource CardStyle}" Width="380" HorizontalAlignment="Left"
                            Visibility="{Binding HasMerchantStock, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel DataContext="{Binding Merchant}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}" Content="Reset shared stock"
                                        Command="{Binding ResetCommand}" ToolTip="Restore the shared town stock for every town; does not reset buildings or Black Markets"/>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Shared town stock"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Text="Seven artifacts in store. Clear a slot to mark it sold. The town's Reset button does not reset this shared stock."/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" Foreground="{StaticResource AccentBrush}" Text="Shared stock has unsaved changes"
                                       Visibility="{Binding HasPendingChanges, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource ArtifactSlotRowTemplate}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="The shared town stock could not be located safely in this savegame. It cannot be edited." TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMerchantStock}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
