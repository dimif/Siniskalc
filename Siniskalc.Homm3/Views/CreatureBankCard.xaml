<UserControl x:Class="Siniskalc.Homm3.Views.CreatureBankCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BankBoolToVisibility"/>
    </UserControl.Resources>
    <StackPanel>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource PillButtonStyle}" Content="Reset" Command="{Binding RestoreCommand}"
                    ToolTip="Restore this garrison and allow another battle for these rewards. Save the edited game to use the reset in Heroes III."/>
            <Border DockPanel.Dock="Right" Padding="8,3" CornerRadius="10" Margin="8,0,8,0" VerticalAlignment="Top">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource HighlightSoftBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCleared}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
            </Border>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Heading}"/>
                <Border Style="{StaticResource EditedMarkStyle}">
                    <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                </Border>
            </StackPanel>
        </DockPanel>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Garrison" FontWeight="SemiBold" Margin="0,0,0,4"
                           ToolTip="For a defeated bank, these are the guards restored by Reset."/>
                <ItemsControl ItemsSource="{Binding Garrison}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Change guard strength and rewards" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <ComboBox ItemsSource="{Binding StrengthChoices}" SelectedIndex="{Binding SelectedStrength, Mode=TwoWay}"
                          Width="NaN" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Content="Upgraded centre stack" IsChecked="{Binding UpgradedCenter, Mode=TwoWay}"
                          Margin="0,8,0,0" Visibility="{Binding HasCenterUpgrade, Converter={StaticResource BankBoolToVisibility}}"/>                
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Rewards" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ResourceReward}" Margin="0,4,0,8"/>
                <ItemsControl ItemsSource="{Binding Artifacts}" ItemTemplate="{StaticResource ArtifactSlotRowTemplate}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
