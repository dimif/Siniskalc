<UserControl x:Class="Siniskalc.Homm3.Views.GeneralInfoView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Homm3.Views"
      xmlns:app="clr-namespace:Siniskalc.Homm3"
      mc:Ignorable="d" d:DesignWidth="900">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <WrapPanel Margin="2">

            <Border Style="{StaticResource CardStyle}" Width="330">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Primary skills"/>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Attack"/>
                        <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Base"/>
                        <wpf:Stepper Grid.Column="2" HorizontalAlignment="Stretch" Value="{Binding Attack}" Minimum="{x:Static app:Constants+Hero.MinPrimarySkill}" Maximum="{x:Static app:Constants+Hero.MaxPrimarySkill}" Step="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource FieldNoteStyle}" Text="{Binding AttackArtifactNote}"/>
                        <TextBlock Grid.Column="3" Margin="12,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Total"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="The skill with its artifacts, as it counts in the game">
                            <TextBlock Style="{StaticResource TotalValueStyle}" Text="{Binding AttackTotal}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Defense"/>
                        <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Base"/>
                        <wpf:Stepper Grid.Column="2" HorizontalAlignment="Stretch" Value="{Binding Defense}" Minimum="{x:Static app:Constants+Hero.MinPrimarySkill}" Maximum="{x:Static app:Constants+Hero.MaxPrimarySkill}" Step="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource FieldNoteStyle}" Text="{Binding DefenseArtifactNote}"/>
                        <TextBlock Grid.Column="3" Margin="12,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Total"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="The skill with its artifacts, as it counts in the game">
                            <TextBlock Style="{StaticResource TotalValueStyle}" Text="{Binding DefenseTotal}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Spell power"/>
                        <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Base"/>
                        <wpf:Stepper Grid.Column="2" HorizontalAlignment="Stretch" Value="{Binding SpellPower}" Minimum="{x:Static app:Constants+Hero.MinPrimarySkill}" Maximum="{x:Static app:Constants+Hero.MaxPrimarySkill}" Step="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource FieldNoteStyle}" Text="{Binding SpellPowerArtifactNote}"/>
                        <TextBlock Grid.Column="3" Margin="12,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Total"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="The skill with its artifacts, as it counts in the game">
                            <TextBlock Style="{StaticResource TotalValueStyle}" Text="{Binding SpellPowerTotal}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Knowledge"/>
                        <TextBlock Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Base"/>
                        <wpf:Stepper Grid.Column="2" HorizontalAlignment="Stretch" Value="{Binding Knowledge}" Minimum="{x:Static app:Constants+Hero.MinPrimarySkill}" Maximum="{x:Static app:Constants+Hero.MaxPrimarySkill}" Step="1"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource FieldNoteStyle}" Text="{Binding KnowledgeArtifactNote}"/>
                        <TextBlock Grid.Column="3" Margin="12,0,6,0" Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Text="Total"/>
                        <StackPanel Grid.Column="4" VerticalAlignment="Center" ToolTip="The skill with its artifacts, as it counts in the game">
                            <TextBlock Style="{StaticResource TotalValueStyle}" Text="{Binding KnowledgeTotal}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <heroes:LevelAndClassCard DataContext="{Binding LevelAndClass}"/>


            <heroes:MovementAndSpellPointsCard DataContext="{Binding MovementAndSpellPoints}">
                <heroes:MovementAndSpellPointsCard.ExtraContent>
                    <CheckBox Content="Moved today"
                              DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:GeneralInfoView}}"
                              IsChecked="{Binding MovedToday}"
                              Visibility="{Binding IsHota, Converter={StaticResource BoolToVisibility}}"
                              ToolTip="Set when the hero moves and cleared on a new day. Probably what the game checks before the hero may dig for the grail. Only Horn of the Abyss savefiles have this flag."/>
                </heroes:MovementAndSpellPointsCard.ExtraContent>
            </heroes:MovementAndSpellPointsCard>

            <Border Style="{StaticResource CardStyle}" Width="330">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="War machines"/>
                    <WrapPanel>
                        <Button Style="{StaticResource TileButton}" Command="{Binding SelectAllWarMachinesCommand}"
                                ToolTip="Give the hero every war machine (the ballista, where the hero could have a ballista or a cannon)">
                            <TextBlock FontWeight="SemiBold" Text="All"/>
                        </Button>
                        <CheckBox Name="Ballista" Style="{StaticResource TileCheckBox}" IsChecked="{Binding WarMachinesChecked[0], Mode=TwoWay}" Checked="AddWarMachine" Unchecked="RemoveWarMachine" Tag="Ballista" Visibility="{Binding HasSingleBallista, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontWeight="SemiBold" Text="Ballista"/>
                        </CheckBox>
                        <RadioButton Name="BallistaRadio" PreviewMouseLeftButtonDown="RememberArtillery" PreviewKeyDown="RememberArtilleryKey" Click="UntickArtillery" Style="{StaticResource TileRadioButton}" IsChecked="{Binding WarMachinesChecked[1], Mode=TwoWay}" Checked="AddWarMachine" Unchecked="RemoveWarMachine" Tag="Ballista" Visibility="{Binding IsHota, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontWeight="SemiBold" Text="Ballista"/>
                        </RadioButton>
                        <RadioButton Name="Cannon" PreviewMouseLeftButtonDown="RememberArtillery" PreviewKeyDown="RememberArtilleryKey" Click="UntickArtillery" Style="{StaticResource TileRadioButton}" IsChecked="{Binding WarMachinesChecked[2], Mode=TwoWay}" Checked="AddWarMachine" Unchecked="RemoveWarMachine" Tag="Cannon" Visibility="{Binding IsHota, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock FontWeight="SemiBold" Text="Cannon"/>
                        </RadioButton>
                        <CheckBox Name="Ammo_Cart" Style="{StaticResource TileCheckBox}" IsChecked="{Binding WarMachinesChecked[3], Mode=TwoWay}" Checked="AddWarMachine" Unchecked="RemoveWarMachine" Tag="Ammo_Cart">
                            <TextBlock FontWeight="SemiBold" Text="Ammo cart"/>
                        </CheckBox>
                        <CheckBox Name="First_Aid_Tent" Style="{StaticResource TileCheckBox}" IsChecked="{Binding WarMachinesChecked[4], Mode=TwoWay}" Checked="AddWarMachine" Unchecked="RemoveWarMachine" Tag="First_Aid_Tent">
                            <TextBlock FontWeight="SemiBold" Text="First aid tent"/>
                        </CheckBox>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Width="330">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Morale and luck (read-only)"/>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Morale"/>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding MoraleText}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" Text="{Binding MoraleBreakdown}"/>
                    </Grid>
                    <Grid Margin="0,3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Luck"/>
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding LuckText}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" Text="{Binding LuckBreakdown}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Width="330">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Active adventure spell for this turn"/>                    
                    <WrapPanel>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding DisguiseActive}">
                            <TextBlock FontWeight="SemiBold" Text="Disguise"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding FlyActive}">
                            <TextBlock FontWeight="SemiBold" Text="Fly"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding WaterWalkActive}">
                            <TextBlock FontWeight="SemiBold" Text="Water Walk"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding VisionsActive}">
                            <TextBlock FontWeight="SemiBold" Text="Visions"/>
                        </CheckBox>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Width="330">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Visited buildings (read only)"
                               ToolTip="Buildings the hero visited whose effect is still on it. A battle clears most of them; the stables last until the end of the week."/>
                    <WrapPanel>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding WateringHoleVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Watering hole: +1 morale">
                            <TextBlock FontWeight="SemiBold" Text="Watering hole"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding SwanPondVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Swan pond: +2 luck">
                            <TextBlock FontWeight="SemiBold" Text="Swan pond"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" Width="Auto" MinWidth="140" IsChecked="{Binding FountainOfFortuneVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Fountain of fortune: luck">
                            <TextBlock FontWeight="SemiBold" Text="Fountain of fortune"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" Width="Auto" MinWidth="140" IsChecked="{Binding IdolOfFortuneVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Idol of fortune: +1 morale or +1 luck">
                            <TextBlock FontWeight="SemiBold" Text="Idol of fortune"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding FaerieRingVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Faerie ring: +1 luck">
                            <TextBlock FontWeight="SemiBold" Text="Faerie ring"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding CryptVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Crypt: -1 morale">
                            <TextBlock FontWeight="SemiBold" Text="Crypt"/>
                        </CheckBox>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding StablesVisited, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" ToolTip="Stables: extra movement this week">
                            <TextBlock FontWeight="SemiBold" Text="Stables"/>
                        </CheckBox>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Width="330" Visibility="{Binding CanSleep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Other"/>
                    <WrapPanel>
                        <CheckBox Style="{StaticResource TileCheckBox}" IsChecked="{Binding IsAsleep}"
                                  ToolTip="The hero was put to sleep and does not move until it is woken. A hero that moves wakes up. Found in Shadow of Death and Horn of the Abyss savefiles only.">
                            <TextBlock FontWeight="SemiBold" Text="Asleep"/>
                        </CheckBox>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <heroes:MapPointCard DataContext="{Binding Position}"/>

            <heroes:MapPointCard DataContext="{Binding Destination}"/>

            <Border Style="{StaticResource CardStyle}" Width="672">
                <Border.Visibility>
                    <Binding Path="HasBiography">
                        <Binding.Converter><BooleanToVisibilityConverter/></Binding.Converter>
                    </Binding>
                </Border.Visibility>
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Biography"/>
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="320" Margin="0,3" Width="Auto" HorizontalContentAlignment="Left" VerticalContentAlignment="Top" InputScope="Default" Text="{Binding Biography, Mode=OneWay}"/>
                </StackPanel>
            </Border>

        </WrapPanel>
    </ScrollViewer>
</UserControl>
