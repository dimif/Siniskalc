<Page x:Class="Siniskalc.Homm3.Views.HeroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Homm3.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HeroPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14">
                <Run Text="{Binding HeroClass.Name, Mode=OneWay}"/><Run Text=", level "/><Run Text="{Binding LevelNumber, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding PositionText, Mode=OneWay}"
                       ToolTip="Where the hero is on the map">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,3" VerticalAlignment="Bottom">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GarrisonCastleName}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="· Garrisoned in " Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenGarrisonCastleCommand}" Content="{Binding GarrisonCastleName}"
                        FontSize="14" ToolTip="Go to castle"/>
            </StackPanel>
            <Border Style="{StaticResource EditedMarkStyle}" ToolTip="This hero has changes that are not saved yet">
                <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button Style="{StaticResource ResetPillStyle}" Content="Reset" Command="{Binding ResetCommand}"
                    ToolTip="Put everything of this hero back to what the savegame had"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Owner" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
            <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{Binding OwnerChoices}" SelectedItem="{Binding SelectedOwner}"
                      ToolTip="Which player the hero belongs to. A neutral hero is taken off the map."/>
        </StackPanel>
        </StackPanel>

        <!-- The pages of a hero, as tabs. -->
        <ListBox Grid.Row="1" SelectionMode="Single" x:Name="sidebar" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                 Margin="16,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <wpf:NavButton Text="General"/>
            <wpf:NavButton Text="Skills"/>
            <wpf:NavButton Text="Creatures"/>
            <wpf:NavButton Text="Spells"/>
            <wpf:NavButton Text="Artifacts"/>
            <wpf:NavButton Text="Backpack"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- The panel of each tab, shown while its tab is the picked one. A panel keeps the data context of the page, which has the
             selected tab; the data context of what it shows is the hero's view model of that tab. -->
        <Grid Grid.Row="2" Margin="8,8,8,0">
            <Grid Style="{StaticResource TabPanel0}">
                <local:GeneralInfoView DataContext="{Binding GeneralInfoViewModel}"/>
            </Grid>
            <Grid Style="{StaticResource TabPanel1}">
                <wpf:SecondarySkillsView DataContext="{Binding SecondarySkillsViewModel}"/>
            </Grid>
            <Grid Style="{StaticResource TabPanel2}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <local:ArmyEditor DataContext="{Binding ArmyViewModel}"/>
                </ScrollViewer>
            </Grid>
            <Grid Style="{StaticResource TabPanel3}">
                <wpf:SpellsView DataContext="{Binding SpellsViewModel}"/>
            </Grid>
            <Grid Style="{StaticResource TabPanel4}">
                <local:ArtifactsView DataContext="{Binding ArtifactsViewModel}"/>
            </Grid>
            <Grid Style="{StaticResource TabPanel5}">
                <local:BackpackView DataContext="{Binding BackpackViewModel}"/>
            </Grid>
            <wpf:HexEditor x:Name="hexEditor" Style="{StaticResource TabPanel6}"/>
        </Grid>
    </Grid>
</Page>
