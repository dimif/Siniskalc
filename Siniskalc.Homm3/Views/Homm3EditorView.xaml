<UserControl x:Class="Siniskalc.Homm3.Views.Homm3EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Siniskalc.Homm3.ViewModels"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Tree node: a marker in the player's colour, the name, a smaller subtitle, and a dot when it has edits. -->
        <HierarchicalDataTemplate x:Key="NavNodeTemplate" DataType="{x:Type vm:NavNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Text="♛" ToolTip="Capital"
                           Visibility="{Binding IsCapital, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource HighlightBrush}" Text="✦" ToolTip="{Binding GrailText, StringFormat='Grail: {0}'}"
                           Visibility="{Binding HasGrail, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="⚔" FontSize="10" ToolTip="{Binding GarrisonedHeroName, StringFormat='Garrisoned: {0}'}"
                           Visibility="{Binding HasGarrisonedHero, Converter={StaticResource BoolToVisibility}}"/>
                <!-- One text block, so the smaller subtitle sits on the baseline of the bold name. -->
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" " FontSize="11"/><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding GarrisonedHeroSuffix, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding BanishingSuffix, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding ChangesMark, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="9" ToolTip="Unsaved changes"/>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="NavTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation: players and their heroes. -->
        <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
            <wpf:SearchBox DockPanel.Dock="Top" Margin="8" Padding="4,3"
                           x:Name="heroFilterBox"
                           Placeholder="Search players, heroes, towns..."
                           ToolTip="Type part of a player's, hero's or town's name"
                           IsEnabled="{Binding IsGameLoaded}"
                           Text="{Binding HeroFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <TreeView x:Name="navTree" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding NavigationNodes}"
                      ItemTemplate="{StaticResource NavNodeTemplate}"
                      ItemContainerStyle="{StaticResource NavTreeItemStyle}"/>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}"/>

        <!-- Editor for the selected hero. -->
        <Grid Grid.Column="2">
            <Frame x:Name="heroFrame" NavigationUIVisibility="Hidden"/>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"
                       TextAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Open a savegame to start editing (Ctrl+O)."/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
