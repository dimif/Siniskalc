<Page x:Class="Siniskalc.Homm3.Views.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:vm="clr-namespace:Siniskalc.Homm3.ViewModels"
      xmlns:local="clr-namespace:Siniskalc.Homm3.Views"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      Title="Map">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityMap"/>
        <DataTemplate x:Key="BankOverviewRow" DataType="{x:Type vm:CreatureBankViewModel}">
            <Grid Margin="0,3" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="45"/>
                    <ColumnDefinition Width="155"/>
                    <ColumnDefinition Width="115"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Tier}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding Location}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="2" Width="105" HorizontalAlignment="Left" ItemsSource="{Binding DefeatChoices}"
                          SelectedIndex="{Binding SelectedDefeat, Mode=TwoWay}" ToolTip="Whether this bank has been defeated. Undefeated restores the displayed garrison for another battle."/>
                <TextBlock Grid.Column="3" Text="{Binding RewardSummary}" VerticalAlignment="Center" ToolTip="{Binding RewardSummary}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <heroes:PageHeader Grid.Row="0" Margin="16,14,16,4" ColorHex="#9AA3AE" Title="Map"
                           EditedToolTip="The map records have changes that are not saved yet"
                           ResetToolTip="Undo unsaved changes to Black Markets and creature banks">
            <TextBlock Margin="12,0,0,3" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding MapSummary}"/>
        </heroes:PageHeader>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel0}">
                    <TextBlock Text="Merchants" Style="{StaticResource CardHeadingStyle}" Margin="6,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Merchants}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MerchantViewModel}">
                                <Border Style="{StaticResource CardStyle}" Width="380">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding Name}"/>
                                        <TextBlock Style="{StaticResource FieldNoteStyle}" Margin="0,0,0,4" Text="{Binding Location}"
                                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibilityMap}}"/>
                                        <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Text="The seven artifacts in store. Clear a slot for an artifact that was sold. Not yet tried in the game."/>
                                        <ItemsControl ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource ArtifactSlotRowTemplate}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="6,8,0,0" Text="The stock of the merchants was not found in this savegame.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasMerchants}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Style="{StaticResource TabPanel1}">
                    <TextBlock Text="{Binding BankGroupName}" Style="{StaticResource CardHeadingStyle}"/>
                    <TextBlock Text="{Binding BankSummary}" Margin="0,4,0,8"/>
                    <heroes:ListCard x:Name="bankOverview" Heading="{Binding BankGroupName}" CardWidth="1120" ItemsSource="{Binding VisibleBanks}"
                                     ItemTemplate="{StaticResource BankOverviewRow}" SelectedItem="{Binding SelectedBank, Mode=TwoWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="45"/>
                                <ColumnDefinition Width="155"/>
                                <ColumnDefinition Width="115"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tier" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1" Text="Location" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="State" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="3" Text="Rewards" FontWeight="SemiBold"/>
                        </Grid>
                    </heroes:ListCard>
                    <Border x:Name="bankHexCard" Style="{StaticResource CardStyle}" Width="{Binding CardWidth, ElementName=bankOverview}" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Hex: the selected creature-bank record"/>
                            <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="Select a bank in the overview or navigation tree. These bytes are the bank record only; the separate entrance state is reconciled when its defeated state changes."/>
                            <wpf:HexEditor x:Name="bankHexEditor" KnownFieldsHeight="120"/>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="banks" ItemsSource="{Binding VisibleBanks}" SelectedItem="{Binding SelectedBank, Mode=TwoWay}"
                             SelectionChanged="OnBankSelected" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CreatureBankViewModel}">
                                <Border Tag="CreatureBankCard" Width="{Binding CardWidth, Source={x:Reference bankOverview}}" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource HighlightBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <local:CreatureBankCard/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="No banks of this kind could be located safely in this savegame. Only validated HotA records and supported entrance states are editable."
                               TextWrapping="Wrap" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasVisibleBanks}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Style="{StaticResource TabPanel2}">
                    <TextBlock Text="Creature banks" Style="{StaticResource CardHeadingStyle}"/>
                    <TextBlock Text="{Binding MapSummary}" Margin="0,8,0,8"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                               Text="Choose a bank type under Creature banks in the navigation tree to see its garrisons and rewards. Choose a location below that type to highlight it in the list. Only safely located, supported banks are shown."/>
                </StackPanel>
                <StackPanel Style="{StaticResource TabPanel3}">
                    <TextBlock Text="Map contents" Style="{StaticResource CardHeadingStyle}"/>
                    <TextBlock Text="{Binding MapSummary}" Margin="0,8,0,8"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                               Text="Choose Merchants or Creature banks under Map in the navigation tree."/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
