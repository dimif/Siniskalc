<Page x:Class="Siniskalc.Homm3.Views.MapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:vm="clr-namespace:Siniskalc.Homm3.ViewModels"
      xmlns:local="clr-namespace:Siniskalc.Homm3.Views"
      Title="Map">
    <Page.Resources>
        <!-- A mine: what it gives, where its record puts it, its owner and its guard. -->
        <DataTemplate x:Key="MineTemplate" DataType="{x:Type vm:MineRowViewModel}">
            <Grid Margin="0,2" ToolTip="{Binding Kind}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding ResourceName}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding PositionText}"
                           ToolTip="The tile the savegame gives for the mine. It is not the tile a hero stands on to take it: that one is a few tiles away."/>
                <ComboBox Grid.Column="2" HorizontalAlignment="Left" Width="140" ItemsSource="{Binding OwnerField.Choices}" SelectedItem="{Binding OwnerField.Selected}"
                          ToolTip="{Binding OwnerField.ToolTip}"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding GuardText}"/>
            </Grid>
        </DataTemplate>

        <!-- A dwelling: the creature it gives, where it is, its owner and the creatures that can be hired. -->
        <DataTemplate x:Key="DwellingTemplate" DataType="{x:Type vm:MapDwellingRowViewModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding CreatureName}"/>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding PositionText}"
                           ToolTip="The tile the savegame gives for the dwelling. On the test map a hero stood on it to flag a dwelling of the Castle, and 3 tiles lower to visit a neutral one: the entrance can be a few tiles off."/>
                <ComboBox Grid.Column="2" HorizontalAlignment="Left" Width="140" ItemsSource="{Binding OwnerField.Choices}" SelectedItem="{Binding OwnerField.Selected}"
                          ToolTip="{Binding OwnerField.ToolTip}"/>
                <TextBox Grid.Column="3" HorizontalAlignment="Left" Width="90" HorizontalContentAlignment="Right" Text="{Binding StockText, UpdateSourceTrigger=LostFocus}"
                         ToolTip="The creatures that can be hired now"/>
            </Grid>
        </DataTemplate>

        <!-- The heading of a sortable column: a flat button with the name and the arrow. -->
        <Style x:Key="SortHeadingStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <heroes:PageHeader Grid.Row="0" Margin="16,14,16,4" ColorHex="#9AA3AE" Title="Map"
                           EditedToolTip="The mines have changes that are not saved yet"
                           ResetToolTip="Put every mine back to what the savegame had">
            <TextBlock Margin="12,0,0,3" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding MapSummary}"/>
        </heroes:PageHeader>

        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="Mines"/>
            <wpf:NavButton Text="Dwellings"/>
        </ListBox>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
            <!-- Dwellings -->
            <StackPanel Style="{StaticResource TabPanel1}">
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Dwellings"/>
                        <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Who owns each dwelling of the map and how many creatures can be hired there now. Not yet tried in the game."/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding DwellingList.Columns[Creature].Label}" Command="{Binding DwellingList.Columns[Creature].SortCommand}" ToolTip="Sort by creature"/>
                            <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding DwellingList.Columns[Location].Label}" Command="{Binding DwellingList.Columns[Location].SortCommand}" ToolTip="Sort by location (X, then Y)"/>
                            <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding DwellingList.Columns[Owner].Label}" Command="{Binding DwellingList.Columns[Owner].SortCommand}" ToolTip="Sort by owner"/>
                            <Button Grid.Column="3" Style="{StaticResource SortHeadingStyle}" Content="{Binding DwellingList.Columns[Available].Label}" Command="{Binding DwellingList.Columns[Available].SortCommand}" ToolTip="Sort by the creatures that can be hired"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Dwellings}" ItemTemplate="{StaticResource DwellingTemplate}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            <!-- Mines -->
            <StackPanel Style="{StaticResource TabPanel0}">
                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Mines"/>
                        <TextBlock Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Who owns each mine of the map. Pick a mine to see its guard below. Not yet tried in the game."/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Resource].Label}" Command="{Binding MineList.Columns[Resource].SortCommand}" ToolTip="Sort by resource"/>
                            <Button Grid.Column="1" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Location].Label}" Command="{Binding MineList.Columns[Location].SortCommand}" ToolTip="Sort by location (X, then Y)"/>
                            <Button Grid.Column="2" Style="{StaticResource SortHeadingStyle}" Content="{Binding MineList.Columns[Owner].Label}" Command="{Binding MineList.Columns[Owner].SortCommand}" ToolTip="Sort by owner"/>
                            <TextBlock Grid.Column="3" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Text="Guard"/>
                        </Grid>
                        <ListBox ItemsSource="{Binding Mines}" SelectedItem="{Binding SelectedMine}" ItemTemplate="{StaticResource MineTemplate}"
                                 BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="{Binding GuardHeading}"/>
                        <local:ArmyEditor DataContext="{Binding GuardEditor}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
