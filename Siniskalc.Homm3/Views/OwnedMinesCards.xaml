<UserControl x:Class="Siniskalc.Homm3.Views.OwnedMinesCards"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
             xmlns:local="clr-namespace:Siniskalc.Homm3.Views">
    <!-- The mines of one owner, with the guard of the one picked between the list and its bytes. The DataContext is an OwnedMapObjectsViewModel. -->
    <heroes:OwnedMinesCard Note="Who owns each mine. Pick a mine to see its guard below." SummaryHeading="Guard" ShowLevel="True">
        <heroes:OwnedMinesCard.Detail>
            <local:ArmyEditor DataContext="{Binding GuardEditor}">
                <local:ArmyEditor.Style>
                    <Style TargetType="local:ArmyEditor">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:ArmyEditor.Style>
            </local:ArmyEditor>
        </heroes:OwnedMinesCard.Detail>
    </heroes:OwnedMinesCard>
</UserControl>
