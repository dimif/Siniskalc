<Page x:Class="Siniskalc.Homm3.Views.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:heroes="clr-namespace:Siniskalc.Heroes.Wpf.Views;assembly=Siniskalc.Heroes.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Homm3.Views"
      xmlns:vm="clr-namespace:Siniskalc.Homm3.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlayerPage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityTab"/>
        <!-- The pages of cards scroll, except the hex tab, which has its own scrolling. -->
        <Style x:Key="CardsScrollerStyle" TargetType="ScrollViewer">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedTab}" Value="4">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <heroes:PageHeader Grid.Row="0" Margin="16,14,16,4" ColorHex="{Binding ColorHex}" Title="{Binding Name}"
                           EditedToolTip="This player has changes that are not saved yet"
                           ResetToolTip="Put every resource of this player back to what the savegame had">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}" FontSize="14" Text="{Binding ControlText}"/>
                <Border Style="{StaticResource BanishingPillStyle}" Margin="12,0,0,4" VerticalAlignment="Bottom">
                    <TextBlock Text="{Binding BanishingText}"/>
                </Border>
            </StackPanel>
        </heroes:PageHeader>

        <!-- The pages of a player, as tabs. -->
        <ListBox Grid.Row="1" Style="{StaticResource TabStripStyle}" x:Name="tabs" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <wpf:NavButton Text="General"/>
            <wpf:NavButton Text="Heroes"/>
            <wpf:NavButton Text="Towns"/>
            <wpf:NavButton Text="Obelisks" Visibility="{Binding Obelisks.HasObelisks, Converter={StaticResource BoolToVisibilityTab}}"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- Hex -->
        <wpf:HexEditor Grid.Row="2" x:Name="hexEditor" Margin="8,8,8,0" Style="{StaticResource TabPanel4}"/>

        <ScrollViewer Grid.Row="2" Style="{StaticResource CardsScrollerStyle}" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- General: the resources, and the countdown to banishing of a player with no town -->
                <Grid Style="{StaticResource TabPanel0}">
                    <heroes:ResourcesPanel Note="Amounts are limited to 999,999 for each resource, and 999,999,999 for gold. Hold Shift while pressing + or − to step by ten.">
                        <!-- Only a player who owns no town has days left; the buttons of a banished player are disabled. -->
                        <Border Margin="0,12,0,0" HorizontalAlignment="Left" Width="440">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBanishing}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,8" Text="Banishing"
                                           ToolTip="A player who owns no town is banished when the days run out. Giving the player a town stops the countdown."/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource MutedBrush}" Text="Days left"/>
                                    <ItemsControl ItemsSource="{Binding DayChoices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DaysLeftChoiceViewModel}">
                                                <Button Margin="0,0,6,0" MinWidth="34" Command="{Binding SelectCommand}" Content="{Binding Days}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </heroes:ResourcesPanel>
                </Grid>

                <!-- Heroes -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel1}">
                    <heroes:ItemsCard Heading="Heroes" ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource LinkTemplate}"
                                      HasItems="{Binding HasHeroes}" EmptyText="This player has no heroes"/>
                    <heroes:TavernCard ItemsSource="{Binding TavernPlaces}"/>
                </WrapPanel>

                <!-- Towns -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <heroes:ItemsCard Heading="Towns" ItemsSource="{Binding Castles}" ItemTemplate="{StaticResource CastleLinkTemplate}"
                                      HasItems="{Binding HasCastles}" EmptyText="This player has no towns"/>
                </WrapPanel>

                <!-- Obelisks -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel3}">
                    <!-- The obelisks of the map and which of them this player has visited. Only for savegames in which they were found. -->
                    <heroes:ObeliskVisitsCard DataContext="{Binding Obelisks}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
