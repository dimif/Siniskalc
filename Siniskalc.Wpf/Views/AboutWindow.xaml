<Window x:Class="Siniskalc.Wpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About"
        SizeToContent="Height"
        Width="480"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding VersionText}" Margin="0,2,0,0" Opacity="0.7"/>
        <TextBlock Text="{Binding Description}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,12,0,0">
            <Hyperlink Command="{Binding OpenRepositoryCommand}"><Run Text="{Binding RepositoryUrl, Mode=OneWay}"/></Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,4,0,0">
            <Hyperlink Command="{Binding OpenReleasesCommand}">Check for a newer version</Hyperlink>
        </TextBlock>
        <TextBlock Text="{Binding License}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <ItemsControl ItemsSource="{Binding Notices}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.7"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="OK" IsDefault="True" IsCancel="True" Width="80" Margin="0,16,0,0" HorizontalAlignment="Right"/>
    </StackPanel>
</Window>
