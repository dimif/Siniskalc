<UserControl x:Class="Siniskalc.Wpf.Views.ArmyEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Siniskalc.Wpf.Views"
             xmlns:vm="clr-namespace:Siniskalc.Wpf.ViewModels">
    <!-- The army of a hero or the garrison of a castle: its slots and a finder to add creatures. The DataContext is an ArmyViewModelBase. -->
    <StackPanel IsEnabled="{Binding IsEditable}">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Army"/>
                    <TextBlock Margin="16,0,0,8" Style="{StaticResource CardHeadingStyle}" FontWeight="Normal" Text="{Binding ArmySummary}"
                               ToolTip="What all the stacks of the army add up to"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CreatureSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StackSlotViewModel}">
                            <Border Width="440" Margin="0,0,8,8" Padding="10,8" Background="White" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" CornerRadius="3">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayNumber, StringFormat=Slot {0}}" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="◀" Command="{Binding MoveLeftCommand}"
                                                    ToolTip="Move this stack to the left" AutomationProperties.Name="Move left"/>
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="▶" Command="{Binding MoveRightCommand}"
                                                    ToolTip="Move this stack to the right" AutomationProperties.Name="Move right"/>
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}"
                                                    ToolTip="Empty this slot" AutomationProperties.Name="Clear slot"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <ComboBox Width="Auto" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding DataContext.AvailableCreatures, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding SelectedCreature}"/>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock Text="Amount" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Width="Auto" Margin="8,0,0,0" HorizontalContentAlignment="Right"
                                                         IsEnabled="{Binding HasCreature}"
                                                         Text="{Binding CreatureAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- What the whole stack is worth, as the game works it out from one creature. -->
                                        <ItemsControl Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Facts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:StackFact}">
                                                    <DockPanel Margin="0,1" ToolTip="{Binding ToolTip}">
                                                        <TextBlock DockPanel.Dock="Left" Margin="0,0,14,0" Style="{StaticResource MutedTextStyle}" Text="{Binding Label}"/>
                                                        <TextBlock HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" Text="{Binding Value}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNote}" Value="True">
                                                                            <Setter Property="FontWeight" Value="Normal"/>
                                                                            <Setter Property="FontSize" Value="11"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Value}" Value="">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Look up a creature, and put it in the army. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Find creatures"/>
                <local:FinderView DataContext="{Binding Finder}">
                    <local:FinderView.ToolbarContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="New stack of" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox Width="64" Margin="0" HorizontalContentAlignment="Right"
                                     Text="{Binding AddAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="How many creatures a stack you add starts with"/>
                        </StackPanel>
                    </local:FinderView.ToolbarContent>
                </local:FinderView>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
