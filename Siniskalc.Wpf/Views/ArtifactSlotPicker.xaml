<UserControl x:Class="Siniskalc.Wpf.Views.ArtifactSlotPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Siniskalc.Wpf.Views"
             x:Name="root">
    <!-- A button that shows the artifact in a slot. Clicking it opens a popup with a finder of the artifacts that fit.
         DataContext is an ArtifactPickerViewModel. Pointing at the button shows what the artifact does, on the page's info card. -->
    <Grid>
        <Button x:Name="button" MouseEnter="ButtonMouseEnter" MouseLeave="ButtonMouseLeave" Height="26" HorizontalContentAlignment="Left" VerticalContentAlignment="Center" Padding="8,3" Command="{Binding OpenCommand}"
                AutomationProperties.Name="{Binding Label}" ToolTip="Click to pick an artifact">
            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"/>
        </Button>
        <Popup IsOpen="{Binding IsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=button}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="PopupOpened">
            <Border Width="{Binding PopupWidth, ElementName=root}"
                    Margin="0,2,8,8" Padding="10" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                </Border.Effect>
                <local:FinderView DataContext="{Binding Finder}" ListMaxHeight="320"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>
