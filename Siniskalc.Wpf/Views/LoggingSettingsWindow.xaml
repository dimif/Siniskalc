<Window x:Class="Siniskalc.Wpf.Views.LoggingSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logging"
        SizeToContent="Height"
        Width="560"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="Log level" FontWeight="SemiBold"/>
        <ComboBox Margin="0,4,0,0" HorizontalAlignment="Left" Width="160"
                  ItemsSource="{Binding Levels}" SelectedItem="{Binding Level, Mode=TwoWay}"
                  AutomationProperties.Name="Log level"/>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                   Text="Information is the default. Trace and Debug write much more and help when reporting a problem."/>

        <TextBlock Text="Log folder" FontWeight="SemiBold" Margin="0,16,0,0"/>
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Log folder"/>
            <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Padding="10,2" Command="{Binding BrowseCommand}"/>
            <Button Grid.Column="2" Content="Use default" Margin="8,0,0,0" Padding="10,2" Command="{Binding UseDefaultCommand}"/>
        </Grid>
        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.7">
            <Run Text="Left empty, the logs go to "/><Run Text="{Binding DefaultFolder, Mode=OneWay}"/>
        </TextBlock>

        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                   Text="The choice applies the next time the editor starts."/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C42B1C" Text="{Binding Error}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Click="OnOk"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
