<UserControl x:Class="Siniskalc.Wpf.Views.NavigationEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Siniskalc.Wpf.Views"
             xmlns:vm="clr-namespace:Siniskalc.Wpf.ViewModels"
             mc:Ignorable="d">
    <UserControl.Resources>
        <!-- A mark in front of the name of a node: the colour of its tone. -->
        <DataTemplate x:Key="NavBadgeTemplate" DataType="{x:Type vm:NavBadge}">
            <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Text="{Binding Glyph}" ToolTip="{Binding Tooltip}"
                       Foreground="{StaticResource MutedBrush}" FontSize="10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:NavBadgeTone.Accent}">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="{x:Static vm:NavBadgeTone.Highlight}">
                                <Setter Property="Foreground" Value="{StaticResource HighlightBrush}"/>
                                <Setter Property="FontSize" Value="12"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>

        <!-- Tree node: a marker in the player's colour, the badges, the name, a smaller subtitle and notes, and a dot when it has edits. -->
        <HierarchicalDataTemplate x:Key="NavNodeTemplate" DataType="{x:Type vm:NavNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                <ItemsControl ItemsSource="{Binding Badges}" ItemTemplate="{StaticResource NavBadgeTemplate}" Focusable="False" IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <!-- One text block, so the smaller subtitle sits on the baseline of the bold name. -->
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" " FontSize="11"/><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding NotesText, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding ChangesMark, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="9" ToolTip="Unsaved changes"/>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="NavTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="160"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation: players and their heroes and towns. -->
        <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
            <local:SearchBox DockPanel.Dock="Top" Margin="8" Padding="4,3"
                             x:Name="filterBox"
                             Placeholder="Search players, heroes, towns..."
                             ToolTip="Type part of a player's, hero's or town's name"
                             IsEnabled="{Binding IsGameLoaded}"
                             Text="{Binding NavigationFilter, UpdateSourceTrigger=PropertyChanged}"/>
            <TreeView x:Name="navTree" BorderThickness="0" Background="Transparent"
                      ItemsSource="{Binding NavigationNodes}"
                      ItemTemplate="{StaticResource NavNodeTemplate}"
                      ItemContainerStyle="{StaticResource NavTreeItemStyle}"/>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}"/>

        <!-- The page of what is picked in the tree. -->
        <Grid Grid.Column="2">
            <Frame x:Name="pageFrame" NavigationUIVisibility="Hidden"/>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"
                       TextAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Open a savegame to start editing (Ctrl+O)."/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
