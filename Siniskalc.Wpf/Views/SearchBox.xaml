<UserControl x:Class="Siniskalc.Wpf.Views.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <!-- A text box that shows a muted hint of what can be typed while it is empty. -->
    <Grid>
        <TextBox x:Name="box" Width="Auto" Margin="0" HorizontalContentAlignment="Left" InputScope="Default"
                 Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="7,0,7,0" TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource MutedBrush}" Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=box}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
