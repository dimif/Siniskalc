<Window x:Class="Siniskalc.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        SizeToContent="Height"
        Width="600"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="Margin" Value="22,2,0,0"/>
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <!-- Saving -->
        <TextBlock Style="{StaticResource SectionHeading}" Text="Saving"/>
        <CheckBox IsChecked="{Binding BackupOnSave, Mode=TwoWay}" Content="Back up on save" AutomationProperties.Name="Back up on save"/>
        <TextBlock Style="{StaticResource Hint}" Text="Keep a copy of the savegame (save.GM1.bak, save.GM1.bak1, ...) before it is saved over."/>

        <!-- Tools -->
        <Separator Margin="0,16"/>
        <TextBlock Style="{StaticResource SectionHeading}" Text="Tools"/>
        <CheckBox IsChecked="{Binding AdvancedMode, Mode=TwoWay}" Content="Advanced mode" AutomationProperties.Name="Advanced mode"/>
        <TextBlock Style="{StaticResource Hint}" Text="Show the Advanced menu and the hex tabs, for working with the raw bytes of a savegame."/>

        <!-- Logging -->
        <StackPanel Visibility="{Binding HasLogging, Converter={StaticResource BoolToVisibility}}">
            <Separator Margin="0,16"/>
            <TextBlock Style="{StaticResource SectionHeading}" Text="Logging"/>
            <StackPanel DataContext="{Binding Logging}">
                <TextBlock Text="Log level"/>
                <ComboBox Margin="0,4,0,0" HorizontalAlignment="Left" Width="160"
                          ItemsSource="{Binding Levels}" SelectedItem="{Binding Level, Mode=TwoWay}"
                          AutomationProperties.Name="Log level"/>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.7"
                           Text="Information is the default. Trace and Debug write much more and help when reporting a problem."/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Log folder" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Style="{StaticResource TextFieldStyle}" Text="{Binding Folder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Log folder"/>
                    <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="10,2" Command="{Binding BrowseCommand}"/>
                    <Button Grid.Column="3" Content="Use default" Margin="8,0,0,0" Padding="10,2" Command="{Binding UseDefaultCommand}"/>
                </Grid>
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Opacity="0.7">
                    <Run Text="Left empty, the logs go to "/><Run Text="{Binding DefaultFolder, Mode=OneWay}"/><Run Text=". The logging choices apply the next time the editor starts."/>
                </TextBlock>
                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#C42B1C" Text="{Binding Error}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Click="OnOk"/>
            <Button Content="Cancel" IsCancel="True" Width="80" Margin="8,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
