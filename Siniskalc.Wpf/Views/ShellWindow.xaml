<Window x:Class="Siniskalc.Wpf.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:data="clr-namespace:Siniskalc.Core.Data;assembly=Siniskalc.Core"
        xmlns:cmd="clr-namespace:Siniskalc.Wpf.Views"
        mc:Ignorable="d"
        wpf:HexEditor.SourceFile="{Binding Name}"
        Title="{Binding Title}" Height="800" Width="1330">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="PendingChangeTemplate" DataType="{x:Type data:PendingChange}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Path, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Change.Description, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Change.Before, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextDecorations="Strikethrough"/><Run Text=" → "/><Run Text="{Binding Change.After, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Undo" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center"
                        ToolTip="Put this value back to what the savegame had"
                        Command="{Binding DataContext.RevertChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                        Executed="OpenCmdExecuted"
                        CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}"
                        Executed="SaveCmdExecuted"
                        CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}"
                        Executed="SaveAsCmdExecuted"
                        CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}"
                        Executed="UndoCmdExecuted"
                        CanExecute="UndoCmdCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}"
                        Executed="RedoCmdExecuted"
                        CanExecute="RedoCmdCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.Reload}"
                        Executed="ReloadCmdExecuted"
                        CanExecute="ReloadCmdCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.GoToSaveFileFolder}"
                        Executed="GoToSaveFileFolderCmdExecuted"
                        CanExecute="ReloadCmdCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.DumpToFile}"
                Executed="DumpToFileCmdExecuted"
                CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.ViewSaveHex}"
                Executed="ViewSaveHexCmdExecuted"
                CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.ViewArtifacts}"
                Executed="ViewArtifactsCmdExecuted"
                CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.ViewCreatures}"
                Executed="ViewCreaturesCmdExecuted"
                CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Help}"
                Executed="HelpCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.OpenIssues}"
                Executed="OpenIssuesCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.EditSettings}"
                Executed="EditSettingsCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.ShowLogs}"
                Executed="ShowLogsCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.About}"
                Executed="AboutCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.LoadFromDump}"
            Executed="LoadFromDumpCmdExecuted"
            CanExecute="AlwaysCanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Menu x:Name="menu" Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Command="{x:Static ApplicationCommands.Open}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/OpenFile.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static ApplicationCommands.Save}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." Command="{x:Static ApplicationCommands.SaveAs}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static cmd:EditorCommands.Reload}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Refresh.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static cmd:EditorCommands.GoToSaveFileFolder}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/OpenFolder.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="recentMenuItem" Header="_Recent" ItemsSource="{Binding Items}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}"/>
                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Separator/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="Exit">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Exit.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Command="{x:Static ApplicationCommands.Undo}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Undo.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static ApplicationCommands.Redo}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Redo.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Re_vert all changes" Command="{Binding RevertAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Pending changes" IsCheckable="True" IsChecked="{Binding IsPendingChangesOpen, Mode=TwoWay}" IsEnabled="{Binding IsGameLoaded}"/>
                <MenuItem Command="{x:Static cmd:EditorCommands.ViewArtifacts}"/>
                <MenuItem Command="{x:Static cmd:EditorCommands.ViewCreatures}"/>
            </MenuItem>
            <MenuItem Header="_Settings..." Command="{x:Static cmd:EditorCommands.EditSettings}"
                      ToolTip="Saving, the advanced tools and the logging"/>
            <MenuItem Header="_Advanced" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="Export save bytes" Command="{x:Static cmd:EditorCommands.DumpToFile}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/DownloadDocument.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Load save from bytes" Command="{x:Static cmd:EditorCommands.LoadFromDump}">
                    <MenuItem.Icon>
                        <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/OpenFile.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="View save hex" Command="{x:Static cmd:EditorCommands.ViewSaveHex}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User guide" Command="{x:Static ApplicationCommands.Help}" InputGestureText="F1"/>
                <MenuItem Header="Report an _issue" Command="{x:Static cmd:EditorCommands.OpenIssues}"/>
                <MenuItem x:Name="showLogsMenuItem" Header="Show _logs" Command="{x:Static cmd:EditorCommands.ShowLogs}"/>
                <Separator />
                <MenuItem Header="_About Siniskalc" Command="{x:Static cmd:EditorCommands.About}"/>
            </MenuItem>
        </Menu>
        <ToolBar x:Name="toolBar" Grid.Row="1" Style="{StaticResource AppToolBarStyle}">
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Open}" AutomationProperties.Name="Open" ToolTip="Open">
                <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/OpenFile.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Save}" AutomationProperties.Name="Save" ToolTip="Save">
                <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Save.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static cmd:EditorCommands.Reload}" AutomationProperties.Name="Reload" ToolTip="Reload">
                <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Refresh.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static cmd:EditorCommands.GoToSaveFileFolder}" AutomationProperties.Name="Go to save file folder" ToolTip="Go to the folder of the savegame">
                <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/OpenFolder.png" Width="16" Height="16"/>
            </Button>
            <Separator Style="{StaticResource AppToolBarSeparatorStyle}"/>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Undo}" AutomationProperties.Name="Undo" ToolTip="Undo">
                <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Undo.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Redo}" AutomationProperties.Name="Redo" ToolTip="Redo">
                <Image Source="/Siniskalc.Wpf;component/Resources/VS2026/Redo.png" Width="16" Height="16"/>
            </Button>
            <Separator Style="{StaticResource AppToolBarSeparatorStyle}"/>
            <ToggleButton Style="{StaticResource AppToolBarToggleStyle}" IsChecked="{Binding IsPendingChangesOpen, Mode=TwoWay}" IsEnabled="{Binding IsGameLoaded}"
                          ToolTip="Show every value you have changed since opening the savegame">
                <TextBlock>
                    <Run Text="Pending changes"/>
                    <Run Text="{Binding PendingChanges.Count, Mode=OneWay, StringFormat=({0})}"/>
                </TextBlock>
            </ToggleButton>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- The editor of the game that is open: its own pages, shown through the data template of its type. -->
            <ContentControl Grid.Column="0" Content="{Binding Editor}" IsTabStop="False"/>

            <!-- Pending changes. -->
            <Border Grid.Column="1" Width="320" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPendingChangesOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock Text="Pending changes" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <Button Content="✕" DockPanel.Dock="Right" Width="26" Margin="6,0,0,0" Click="ClosePendingChangesClick" ToolTip="Close this pane" AutomationProperties.Name="Close pending changes"/>
                        <Button Content="Revert all" DockPanel.Dock="Right" Padding="8,2" Command="{Binding RevertAllCommand}"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="These values are written to the savegame when you save."/>
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Nothing changed yet. Edit a value and it appears here.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingChanges}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding PendingChanges}" ItemTemplate="{StaticResource PendingChangeTemplate}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
