<UserControl x:Class="Siniskalc.Views.ArmyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Siniskalc.Views"
             xmlns:vm="clr-namespace:Siniskalc.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="800">
    <!-- The army of a hero or the garrison of a castle: its slots and a finder to add creatures. The DataContext is a ArmyViewModel. -->
    <StackPanel IsEnabled="{Binding IsEditable}">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Army"/>
                    <TextBlock Margin="16,0,0,8" Style="{StaticResource CardHeadingStyle}" FontWeight="Normal" Text="{Binding ArmySummary}"
                               ToolTip="What all the stacks of the army add up to: total hit points, cost, AI value and fight value"/>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding CreatureSlots}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ArmySlotViewModel}">
                            <Border Width="440" Margin="0,0,8,8" Padding="10,8" Background="White" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" CornerRadius="3">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayNumber, StringFormat=Slot {0}}" Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="◀" Command="{Binding MoveLeftCommand}"
                                                    ToolTip="Move this stack to the left" AutomationProperties.Name="Move left"/>
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="▶" Command="{Binding MoveRightCommand}"
                                                    ToolTip="Move this stack to the right" AutomationProperties.Name="Move right"/>
                                            <Button Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}"
                                                    ToolTip="Empty this slot" AutomationProperties.Name="Clear slot"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <ComboBox Width="Auto" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding DataContext.AvailableCreatures, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      SelectedItem="{Binding SelectedCreature}"/>
                                            <DockPanel Margin="0,6,0,0">
                                                <TextBlock Text="Amount" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <TextBox Width="Auto" Margin="8,0,0,0" HorizontalContentAlignment="Right"
                                                         IsEnabled="{Binding HasCreature}"
                                                         Text="{Binding CreatureAmount, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DockPanel>
                                        </StackPanel>

                                        <!-- What the whole stack is worth, worked out from the stats of one creature. -->
                                        <Grid Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCreature}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Margin="0,1,14,1" Style="{StaticResource MutedTextStyle}" Text="HP Total"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding TotalHealth}"/>
                                            <TextBlock Grid.Row="1" Margin="0,1,14,1" Style="{StaticResource MutedTextStyle}" Text="Damage"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding TotalDamage}"/>
                                            <TextBlock Grid.Row="2" Margin="0,1,14,1" Style="{StaticResource MutedTextStyle}" Text="Cost"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding TotalCost}"/>
                                            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,1" HorizontalAlignment="Right" TextWrapping="Wrap"
                                                       Style="{StaticResource FieldNoteStyle}" Text="{Binding TotalOtherCost}"/>
                                            <TextBlock Grid.Row="4" Margin="0,1,14,1" Style="{StaticResource MutedTextStyle}" Text="AI value"
                                                       ToolTip="What the computer player counts the stack as worth"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding TotalAiValue}"/>
                                            <TextBlock Grid.Row="5" Margin="0,1,14,1" Style="{StaticResource MutedTextStyle}" Text="Fight value"
                                                       ToolTip="How much the stack counts for in the strength of an army"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding TotalFightValue}"/>
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Look up a creature by name, town or level, and put it in the army. -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Find creatures"/>
                <wpf:FinderView DataContext="{Binding Finder}">
                    <wpf:FinderView.ToolbarContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="New stack of" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource MutedTextStyle}"/>
                            <TextBox Width="64" Margin="0" HorizontalContentAlignment="Right"
                                     Text="{Binding AddAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="How many creatures a stack you add starts with"/>
                        </StackPanel>
                    </wpf:FinderView.ToolbarContent>
                </wpf:FinderView>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
