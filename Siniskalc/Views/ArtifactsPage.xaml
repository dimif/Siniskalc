<Page x:Class="Siniskalc.Views.ArtifactsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Views"
      xmlns:ent="clr-namespace:Siniskalc.Entities"
      mc:Ignorable="d"
      d:DesignWidth="900"
      Title="Artifacts">
    <Page.Resources>
        <!-- One slot: the button that opens the picker, and a button that takes the artifact off. -->
        <DataTemplate x:Key="SlotRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource FieldLabelStyle}" Text="{Binding Label}"/>
                <local:ArtifactSlotPicker Grid.Column="1"/>
                <Button Grid.Column="2" Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}"
                        Width="26" Height="26" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="Take this artifact off" AutomationProperties.Name="{Binding Label, StringFormat=Clear {0}}"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="340"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Worn"/>
                        <ItemsControl ItemsSource="{Binding WornSlots}" ItemTemplate="{StaticResource SlotRowTemplate}"/>
                    </StackPanel>
            </Border>
            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Carried"/>
                        <ItemsControl ItemsSource="{Binding CarriedSlots}" ItemTemplate="{StaticResource SlotRowTemplate}"/>
                    </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Total effects"/>
                        <ItemsControl ItemsSource="{Binding TotalEffectLines}" ItemTemplate="{StaticResource EffectLineTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding TotalEffects.Other}"/>
                        <TextBlock TextWrapping="Wrap" Text="Nothing worn does anything yet.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoEffects}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
            </Border>
            <local:ArtifactInfoView Grid.Row="1" Grid.Column="1" Margin="6"/>
            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
                <wpf:FinderView DataContext="{Binding Finder}"/>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
