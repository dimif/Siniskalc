<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <!-- The colours and the styles of the controls that every page uses; the styles below are the ones that only make sense for heroes. -->
        <ResourceDictionary Source="pack://application:,,,/Siniskalc.Wpf;component/Styles/SiniskalcStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- A tile that lights up in the accent colour when it is on or ticked: war machines, adventure spells, obelisks, visited buildings. -->
    <ControlTemplate x:Key="TileTemplate" TargetType="ToggleButton">
        <Border x:Name="tile" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,8" SnapsToDevicePixels="True">
            <DockPanel>
                <TextBlock x:Name="tick" DockPanel.Dock="Right" Text="✓" FontWeight="Bold" VerticalAlignment="Top" Margin="8,0,0,0"
                           Foreground="{StaticResource AccentBrush}" Visibility="Hidden"/>
                <ContentPresenter VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="tile" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TileCheckBox" TargetType="CheckBox">
        <Setter Property="Template" Value="{StaticResource TileTemplate}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- A button that looks like the tiles above, for the actions that go with them ("All", "None"). -->
    <ControlTemplate x:Key="TileButtonTemplate" TargetType="Button">
        <Border x:Name="tile" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="4"
                Padding="10,8" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" TextElement.Foreground="{StaticResource AccentBrush}"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="tile" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="tile" Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="TileButton" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource TileButtonTemplate}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="TileRadioButton" TargetType="RadioButton">
        <Setter Property="Template" Value="{StaticResource TileTemplate}"/>
        <Setter Property="Width" Value="140"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <!-- One line of what artifacts do: the effect on the left, its amount on the right. -->
    <DataTemplate x:Key="EffectLineTemplate">
        <DockPanel Margin="0,2,18,2">
            <TextBlock DockPanel.Dock="Right" FontWeight="SemiBold" Margin="10,0,0,0" Text="{Binding Value}"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Label}"/>
        </DockPanel>
    </DataTemplate>

    <!-- The small buttons that move or clear a slot (creatures, secondary skills). -->
    <Style x:Key="SlotButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Focusable" Value="True"/>
    </Style>

</ResourceDictionary>
