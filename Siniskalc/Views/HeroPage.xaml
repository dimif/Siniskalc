<Page x:Class="Siniskalc.Views.HeroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HeroPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4">
        <StackPanel Orientation="Horizontal">
            <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14">
                <Run Text="{Binding HeroClass.Name, Mode=OneWay}"/><Run Text=", level "/><Run Text="{Binding LevelNumber, Mode=OneWay}"/>
            </TextBlock>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="14" Text="{Binding PositionText, Mode=OneWay}"
                       ToolTip="Where the hero is on the map">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,3" VerticalAlignment="Bottom">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GarrisonCastleName}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="· Garrisoned in " Foreground="{StaticResource MutedBrush}" FontSize="14" VerticalAlignment="Center"/>
                <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenGarrisonCastleCommand}" Content="{Binding GarrisonCastleName}"
                        FontSize="14" ToolTip="Go to castle"/>
            </StackPanel>
            <Border Margin="12,0,0,4" Padding="6,1" VerticalAlignment="Bottom" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                    ToolTip="This hero has changes that are not saved yet">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button Margin="6,0,0,4" VerticalAlignment="Bottom" Content="Reset" Command="{Binding ResetCommand}"
                    ToolTip="Put everything of this hero back to what the savegame had">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Owner" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}"/>
            <ComboBox Width="130" Margin="8,0,0,0" ItemsSource="{Binding OwnerChoices}" SelectedItem="{Binding SelectedOwner}"
                      ToolTip="Which player the hero belongs to. A neutral hero is taken off the map."/>
        </StackPanel>
        </StackPanel>

        <!-- The pages of a hero, as tabs. -->
        <ListBox Grid.Row="1" SelectionMode="Single" SelectionChanged="SidebarSelectionChanged" x:Name="sidebar"
                 Margin="16,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <wpf:NavButton Navlink="/GeneralInfoPage.xaml" Text="General"/>
            <wpf:NavButton Navlink="/SecondarySkillsPage.xaml" Text="Skills"/>
            <wpf:NavButton Navlink="/ArmyPage.xaml" Text="Creatures"/>
            <wpf:NavButton Navlink="/SpellsPage.xaml" Text="Spells"/>
            <wpf:NavButton Navlink="/ArtifactsPage.xaml" Text="Artifacts"/>
            <wpf:NavButton Navlink="/BackpackPage.xaml" Text="Backpack"/>
            <wpf:NavButton Navlink="/HexPage.xaml" Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <Frame Grid.Row="2" x:Name="navframe" NavigationUIVisibility="Hidden" Margin="8,8,8,0"/>
    </Grid>
</Page>
