<Window x:Class="Siniskalc.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Siniskalc.ViewModels"
        xmlns:data="clr-namespace:Siniskalc.Core.Data;assembly=Siniskalc.Core"
        xmlns:cmd="clr-namespace:Siniskalc.Views"
        mc:Ignorable="d"
        wpf:HexEditor.SourceFile="{Binding CurrentGame.Name}"
        Title="Siniskalc - Heroes of Might and Magic III" Height="800" Width="1330">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Tree node: a marker in the player's colour, the name, a smaller subtitle, and a dot when it has edits. -->
        <HierarchicalDataTemplate x:Key="NavNodeTemplate" DataType="{x:Type vm:NavNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Text="♛" ToolTip="Capital"
                           Visibility="{Binding IsCapital, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource HighlightBrush}" Text="✦" ToolTip="{Binding GrailText, StringFormat='Grail: {0}'}"
                           Visibility="{Binding HasGrail, Converter={StaticResource BoolToVisibility}}"/>
                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="⚔" FontSize="10" ToolTip="{Binding GarrisonedHeroName, StringFormat='Garrisoned: {0}'}"
                           Visibility="{Binding HasGarrisonedHero, Converter={StaticResource BoolToVisibility}}"/>
                <!-- One text block, so the smaller subtitle sits on the baseline of the bold name. -->
                <TextBlock VerticalAlignment="Center">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" " FontSize="11"/><Run Text="{Binding Subtitle, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding GarrisonedHeroSuffix, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="11"/><Run Text="{Binding ChangesMark, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontSize="9" ToolTip="Unsaved changes"/>
                </TextBlock>
            </StackPanel>
        </HierarchicalDataTemplate>

        <Style x:Key="NavTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="PendingChangeTemplate" DataType="{x:Type data:PendingChange}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Path, Mode=OneWay}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{Binding Change.Description, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding Change.Before, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" TextDecorations="Strikethrough"/><Run Text=" → "/><Run Text="{Binding Change.After, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Undo" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center"
                        ToolTip="Put this value back to what the savegame had"
                        Command="{Binding DataContext.RevertChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}"
                        Executed="OpenCmdExecuted"
                        CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Save}"
                        Executed="SaveCmdExecuted"
                        CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.SaveAs}"
                        Executed="SaveAsCmdExecuted"
                        CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Undo}"
                        Executed="UndoCmdExecuted"
                        CanExecute="UndoCmdCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Redo}"
                        Executed="RedoCmdExecuted"
                        CanExecute="RedoCmdCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.Reload}"
                        Executed="ReloadCmdExecuted"
                        CanExecute="ReloadCmdCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.DumpToFile}"
                Executed="DumpToFileCmdExecuted"
                CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.ViewSaveHex}"
                Executed="ViewSaveHexCmdExecuted"
                CanExecute="GameLoadedCanExecute"/>
        <CommandBinding Command="{x:Static ApplicationCommands.Help}"
                Executed="HelpCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.OpenIssues}"
                Executed="OpenIssuesCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.About}"
                Executed="AboutCmdExecuted"
                CanExecute="AlwaysCanExecute"/>
        <CommandBinding Command="{x:Static cmd:EditorCommands.LoadFromDump}"
            Executed="LoadFromDumpCmdExecuted"
            CanExecute="AlwaysCanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Menu x:Name="menu" Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Command="{x:Static ApplicationCommands.Open}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/OpenFile.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static ApplicationCommands.Save}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/Save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." Command="{x:Static ApplicationCommands.SaveAs}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/Save.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static cmd:EditorCommands.Reload}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/Refresh.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem x:Name="recentMenuItem" Header="_Recent" ItemsSource="{Binding Items}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Header}"/>
                            <Setter Property="ToolTip" Value="{Binding ToolTip}"/>
                            <Setter Property="Command" Value="{Binding Command}"/>
                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
                                                <Separator/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="Exit">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/Exit.png"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Command="{x:Static ApplicationCommands.Undo}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/Undo.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{x:Static ApplicationCommands.Redo}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/Redo.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Re_vert all changes" Command="{Binding RevertAllCommand}"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Pending changes" IsCheckable="True" IsChecked="{Binding IsPendingChangesOpen, Mode=TwoWay}" IsEnabled="{Binding IsGameLoaded}"/>
            </MenuItem>
            <MenuItem Header="_Settings">
                <MenuItem Header="_Back up on save" IsCheckable="True" IsChecked="{Binding BackupOnSave, Mode=TwoWay}"
                          ToolTip="Keep a copy of the savegame (save.GM1.bak, save.GM1.bak1, ...) before it is saved over"/>
                <MenuItem Header="_Advanced mode" IsCheckable="True" IsChecked="{Binding IsAdvancedMode, Mode=TwoWay}"
                          ToolTip="Show the Advanced menu and the hex tabs"/>
            </MenuItem>
            <MenuItem Header="_Advanced" Visibility="{Binding IsAdvancedMode, Converter={StaticResource BoolToVisibility}}">
                <MenuItem Header="Export save bytes" Command="{x:Static cmd:EditorCommands.DumpToFile}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/DownloadDocument.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Load save from bytes" Command="{x:Static cmd:EditorCommands.LoadFromDump}">
                    <MenuItem.Icon>
                        <Image Source="/Resources/VS2026/OpenFile.png"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="View save hex" Command="{x:Static cmd:EditorCommands.ViewSaveHex}"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_User guide" Command="{x:Static ApplicationCommands.Help}" InputGestureText="F1"/>
                <MenuItem Header="Report an _issue" Command="{x:Static cmd:EditorCommands.OpenIssues}"/>
                <Separator />
                <MenuItem Header="_About Siniskalc" Command="{x:Static cmd:EditorCommands.About}"/>
            </MenuItem>
        </Menu>
        <ToolBar x:Name="toolBar" Grid.Row="1" Style="{StaticResource AppToolBarStyle}">
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Open}" AutomationProperties.Name="Open" ToolTip="Open">
                <Image Source="/Resources/VS2026/OpenFile.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Save}" AutomationProperties.Name="Save" ToolTip="Save">
                <Image Source="/Resources/VS2026/Save.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static cmd:EditorCommands.Reload}" AutomationProperties.Name="Reload" ToolTip="Reload">
                <Image Source="/Resources/VS2026/Refresh.png" Width="16" Height="16"/>
            </Button>
            <Separator Style="{StaticResource AppToolBarSeparatorStyle}"/>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Undo}" AutomationProperties.Name="Undo" ToolTip="Undo">
                <Image Source="/Resources/VS2026/Undo.png" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource AppToolBarButtonStyle}" Command="{x:Static ApplicationCommands.Redo}" AutomationProperties.Name="Redo" ToolTip="Redo">
                <Image Source="/Resources/VS2026/Redo.png" Width="16" Height="16"/>
            </Button>
            <Separator Style="{StaticResource AppToolBarSeparatorStyle}"/>
            <ToggleButton Style="{StaticResource AppToolBarToggleStyle}" IsChecked="{Binding IsPendingChangesOpen, Mode=TwoWay}" IsEnabled="{Binding IsGameLoaded}"
                          ToolTip="Show every value you have changed since opening the savegame">
                <TextBlock>
                    <Run Text="Pending changes"/>
                    <Run Text="{Binding PendingChanges.Count, Mode=OneWay, StringFormat=({0})}"/>
                </TextBlock>
            </ToggleButton>
        </ToolBar>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation: players and their heroes. -->
            <DockPanel Grid.Column="0" Background="{StaticResource PanelBrush}">
                <wpf:SearchBox DockPanel.Dock="Top" Margin="8" Padding="4,3"
                               x:Name="heroFilterBox"
                               Placeholder="Search players, heroes, towns..."
                               ToolTip="Type part of a player's, hero's or town's name"
                               IsEnabled="{Binding IsGameLoaded}"
                               Text="{Binding HeroFilter, UpdateSourceTrigger=PropertyChanged}"/>
                <TreeView x:Name="navTree" BorderThickness="0" Background="Transparent"
                          ItemsSource="{Binding NavigationNodes}"
                          ItemTemplate="{StaticResource NavNodeTemplate}"
                          ItemContainerStyle="{StaticResource NavTreeItemStyle}"/>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource LineBrush}"/>

            <!-- Editor for the selected hero. -->
            <Grid Grid.Column="2">
                <Frame x:Name="heroFrame" NavigationUIVisibility="Hidden"/>
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="15"
                           TextAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Open a savegame to start editing (Ctrl+O)."/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Pending changes. -->
            <Border Grid.Column="3" Width="320" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
                    Visibility="{Binding IsPendingChangesOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" LastChildFill="False">
                        <TextBlock Text="Pending changes" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                        <Button Content="✕" DockPanel.Dock="Right" Width="26" Margin="6,0,0,0" Click="ClosePendingChangesClick" ToolTip="Close this pane" AutomationProperties.Name="Close pending changes"/>
                        <Button Content="Revert all" DockPanel.Dock="Right" Padding="8,2" Command="{Binding RevertAllCommand}"/>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="0,4,0,8" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="These values are written to the savegame when you save."/>
                    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Nothing changed yet. Edit a value and it appears here.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPendingChanges}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListBox ItemsSource="{Binding PendingChanges}" ItemTemplate="{StaticResource PendingChangeTemplate}"
                             BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </DockPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Name="status">Ready</TextBlock>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
