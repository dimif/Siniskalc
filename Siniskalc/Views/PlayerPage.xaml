<Page x:Class="Siniskalc.Views.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Views"
      xmlns:vm="clr-namespace:Siniskalc.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PlayerPage">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityTab"/>
        <!-- A resource card turns brass-edged while its amount differs from the savegame. -->
        <Style x:Key="ResourceCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Width" Value="210"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ResourceTemplate" DataType="{x:Type vm:ResourceRowViewModel}">
            <Border Style="{StaticResource ResourceCardStyle}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}"/>
                    </DockPanel>
                    <wpf:Stepper HorizontalAlignment="Stretch" Value="{Binding Value}" Minimum="0" Maximum="{Binding Maximum}" Step="{Binding Step}"/>
                    <TextBlock Style="{StaticResource FieldNoteStyle}" Foreground="{StaticResource AccentBrush}" Text="{Binding DeltaText}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- A panel of a tab: hidden unless the tab with its number is the picked one. -->
        <Style x:Key="TabPanelBase" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
        <Style x:Key="TabPanel0" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=tabs}" Value="0">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabPanel1" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=tabs}" Value="1">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabPanel2" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=tabs}" Value="2">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabPanel3" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=tabs}" Value="3">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TabPanel4" TargetType="FrameworkElement" BasedOn="{StaticResource TabPanelBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=tabs}" Value="4">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The pages of cards scroll, except the hex tab, which has its own scrolling. -->
        <Style x:Key="CardsScrollerStyle" TargetType="ScrollViewer">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=tabs}" Value="4">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A hero of the player: the name opens it, the class and level sit on the right. -->
        <DataTemplate x:Key="HeroLinkTemplate" DataType="{x:Type vm:HeroLinkViewModel}">
            <DockPanel Margin="0,3">
                <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"/>
                <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Command="{Binding OpenCommand}" Content="{Binding Name}"
                        ToolTip="Go to Hero"/>
            </DockPanel>
        </DataTemplate>

        <!-- A hero in a castle, under it: its name, which opens the hero, then its role, such as "Nymus garrisoned - Tazar visiting". -->
        <DataTemplate x:Key="CastleHeroInlineTemplate" DataType="{x:Type vm:CastleHeroRowViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="&#160;·&#160;">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource LinkButtonStyle}" VerticalAlignment="Center" FontSize="12" Command="{Binding OpenCommand}" Content="{Binding Name}"
                        ToolTip="Go to Hero"/>
                <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding RoleText}"/>
            </StackPanel>
        </DataTemplate>
        <!-- A town of the player: the name opens it, the faction sits on the right. -->
        <DataTemplate x:Key="CastleLinkTemplate" DataType="{x:Type vm:CastleLinkViewModel}">
            <Border Margin="0,2" Padding="4,2" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCapital}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasGrail}" Value="True">
                                <Setter Property="Background" Value="{StaticResource HighlightSoftBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- The marks sit before the name; what is under the name lines up with the name, not with the marks. -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" Text="♛" ToolTip="Capital">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCapital}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{StaticResource HighlightBrush}" Text="✦"
                                   ToolTip="{Binding GrailText, StringFormat='Grail: {0}'}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasGrail}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <DockPanel Grid.Column="1">
                        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Text="{Binding Detail}"/>
                        <Button Style="{StaticResource LinkButtonStyle}" HorizontalAlignment="Left" Command="{Binding OpenCommand}" Content="{Binding Name}"
                                ToolTip="Go to Castle"/>
                    </DockPanel>
                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,2,0,0" Style="{StaticResource FieldNoteStyle}" Text="{Binding Status}" ToolTip="The hall and the fortification of this settlement"/>
                    <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource CastleHeroInlineTemplate}" AlternationCount="100">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="16,14,16,4" Orientation="Horizontal">
            <Ellipse Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Fill="{Binding ColorHex}"/>
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Margin="12,0,0,3" VerticalAlignment="Bottom" Foreground="{StaticResource AccentBrush}" FontSize="14" Text="{Binding ControlText}"/>
            <Border Margin="12,0,0,4" Padding="6,1" VerticalAlignment="Bottom" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                    ToolTip="This player has changes that are not saved yet">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="edited" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
            </Border>
            <Button Margin="6,0,0,4" VerticalAlignment="Bottom" Content="Reset" Command="{Binding ResetCommand}"
                    ToolTip="Put every resource of this player back to what the savegame had">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="Normal"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasPendingChanges}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- The pages of a player, as tabs. -->
        <ListBox Grid.Row="1" x:Name="tabs" SelectionMode="Single" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                 Margin="16,0" BorderThickness="0,0,0,1" BorderBrush="{StaticResource LineBrush}" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <wpf:NavButton Text="Resources"/>
            <wpf:NavButton Text="Heroes"/>
            <wpf:NavButton Text="Towns"/>
            <wpf:NavButton Text="Obelisks" Visibility="{Binding Obelisks.HasObelisks, Converter={StaticResource BoolToVisibilityTab}}"/>
            <wpf:NavButton Text="Hex" RequiresAdvancedMode="True"/>
        </ListBox>

        <!-- Hex -->
        <wpf:HexEditor Grid.Row="2" x:Name="hexEditor" Margin="8,8,8,0" Style="{StaticResource TabPanel4}"/>

        <ScrollViewer Grid.Row="2" Style="{StaticResource CardsScrollerStyle}" VerticalScrollBarVisibility="Auto" Margin="8,8,8,0">
            <Grid Margin="8,4,8,16">
                <!-- Resources -->
                <StackPanel Style="{StaticResource TabPanel0}">
                    <ItemsControl Margin="-6,12,0,0" ItemsSource="{Binding Resources}" ItemTemplate="{StaticResource ResourceTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
        
                    <Border Margin="0,12,0,0" HorizontalAlignment="Left" Padding="6" CornerRadius="16" Background="{StaticResource PanelBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource FieldLabelStyle}" Foreground="{StaticResource MutedBrush}" Margin="10,0,10,0" Text="Quick add"/>
                            <Button Style="{StaticResource PillButtonStyle}" Command="{Binding SetAllResourcesCommand}" Content="All +99"
                                    ToolTip="Add 99 of wood, mercury, ore, sulfur, crystal and gems; gold is left alone"/>
                            <Button Style="{StaticResource PillButtonStyle}" Margin="6,0,0,0" Command="{Binding SetRichCommand}" Content="Gold +100k"
                                    ToolTip="Add 100,000 gold"/>
                        </StackPanel>
                    </Border>
        
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource FieldNoteStyle}" TextWrapping="Wrap"
                               Text="Amounts are limited to 999,999 for each resource, and 999,999,999 for gold. Hold Shift while pressing + or − to step by ten."/>

                </StackPanel>

                <!-- Heroes -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel1}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,8" Text="Heroes"/>
                            <ItemsControl ItemsSource="{Binding Heroes}" ItemTemplate="{StaticResource HeroLinkTemplate}"/>
                            <TextBlock Text="This player has no heroes">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasHeroes}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,8" Text="Tavern"/>
                            <ItemsControl ItemsSource="{Binding TavernPlaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TavernPlaceViewModel}">
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Left" Width="90" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Text="{Binding Label}"/>
                                            <Button DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButtonStyle}" Command="{Binding OpenCommand}" Content="Open"
                                                    ToolTip="Go to Hero"/>
                                            <ComboBox ItemsSource="{Binding Choices}" SelectedValue="{Binding SelectedKey}" SelectedValuePath="Key" DisplayMemberPath="Name"
                                                      ToolTip="The hero the tavern of this player offers for hire."/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Towns -->
                <WrapPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel2}">
                    <Border Style="{StaticResource CardStyle}" Width="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeadingStyle}" Margin="0,0,0,8" Text="Towns"/>
                            <ItemsControl ItemsSource="{Binding Castles}" ItemTemplate="{StaticResource CastleLinkTemplate}"/>
                            <TextBlock Text="This player has no towns">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldNoteStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasCastles}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <!-- Obelisks -->
                <StackPanel Margin="-6,0,0,0" Style="{StaticResource TabPanel3}">
                    <!-- The obelisks of the map and which of them this player has visited. Only for savegames in which they were found. -->
                    <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch" DataContext="{Binding Obelisks}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Right" Margin="16,0,0,0" Foreground="{StaticResource MutedBrush}" Text="{Binding Summary}"/>
                                <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Visited obelisks"
                                           ToolTip="The obelisks of the map this player has visited. Each one shows another piece of the puzzle that leads to the Grail."/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Tiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:ObeliskActionViewModel}">
                                        <Button Style="{StaticResource TileButton}" Width="Auto" MinWidth="150" MinHeight="52" Command="{Binding Command}" ToolTip="{Binding ToolTip}">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}"/>
                                        </Button>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:ObeliskRowViewModel}">
                                        <CheckBox Style="{StaticResource TileCheckBox}" Width="Auto" MinWidth="150" IsChecked="{Binding IsVisited}"
                                                  ToolTip="Tick it when this player has visited the obelisk">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Label}"/>
                                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" Text="{Binding Coordinates}"/>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.Resources>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
