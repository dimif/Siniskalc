<Page x:Class="Siniskalc.Views.SecondarySkillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Views"
      xmlns:vm="clr-namespace:Siniskalc.ViewModels"
      mc:Ignorable="d" d:DesignWidth="900"
      Title="Secondary skills">
    <Page.Resources>
        <!-- Three small blocks that fill from the left as the level goes up. -->
        <DataTemplate x:Key="PipTemplate">
            <Border x:Name="pip" Width="14" Height="8" Margin="0,0,3,0" CornerRadius="1" Background="{StaticResource LineBrush}"/>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="True">
                    <Setter TargetName="pip" Property="Background" Value="{StaticResource AccentBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="SlotTemplate" DataType="{x:Type vm:SkillSlotViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Text="{Binding DisplayNumber}"/>
                <ComboBox Grid.Column="1" Width="Auto" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.SkillNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          SelectedItem="{Binding SkillName}"/>
                <ItemsControl Grid.Column="2" Margin="8,0" VerticalAlignment="Center" ItemsSource="{Binding Pips}" ItemTemplate="{StaticResource PipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ComboBox Grid.Column="3" Width="Auto" HorizontalAlignment="Stretch" IsEnabled="{Binding IsFilled}"
                          ItemsSource="{Binding DataContext.SlotLevelNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          SelectedItem="{Binding LevelName}"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource SlotButtonStyle}" Content="↑" Command="{Binding MoveUpCommand}" ToolTip="Move this skill up" AutomationProperties.Name="Move skill up"/>
                    <Button Style="{StaticResource SlotButtonStyle}" Content="↓" Command="{Binding MoveDownCommand}" ToolTip="Move this skill down" AutomationProperties.Name="Move skill down"/>
                    <Button Style="{StaticResource SlotButtonStyle}" Content="⊘" Command="{Binding HideCommand}" ToolTip="Keep the level, but do not show this skill on the hero screen" AutomationProperties.Name="Hide skill"/>
                    <Button Style="{StaticResource SlotButtonStyle}" Content="✕" Command="{Binding ClearCommand}" ToolTip="Remove this skill; the ones after it move up" AutomationProperties.Name="Remove skill"/>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SkillTemplate" DataType="{x:Type vm:SkillRowViewModel}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding Name}"/>
                <ComboBox Grid.Column="1" Width="Auto" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding DataContext.RowLevelNames, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          SelectedItem="{Binding LevelName}"/>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Placement}"
                           Style="{StaticResource MutedTextStyle}" Text="{Binding Placement}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Style="{StaticResource SlotButtonStyle}" Width="44" Content="Show" Command="{Binding ShowCommand}"
                            ToolTip="Put this skill in a free slot so the hero screen shows it"/>
                    <Button Style="{StaticResource SlotButtonStyle}" Width="44" Content="Hide" Command="{Binding HideCommand}"
                            ToolTip="Keep the level, but do not show this skill on the hero screen"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Padding="12,8" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasExtraSkills}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ExtraSummary}" TextWrapping="Wrap"/>
            </Border>

            <!-- The slots the hero screen shows: the first four on the left, the rest on the right. -->
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource MutedTextStyle}" Text="{Binding SlotSummary}"/>
                        <TextBlock Style="{StaticResource CardHeadingStyle}" Text="Slots"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftSlots}" ItemTemplate="{StaticResource SlotTemplate}"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding RightSlots}" ItemTemplate="{StaticResource SlotTemplate}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Every skill, including the ones the hero screen cannot show. -->
            <Border Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardHeadingStyle}" Text="All skills"/>
                    <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}"
                               Text="The game only allows a hero to learn eight skills, but it applies every skill that has a level."/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding LeftSkills}" ItemTemplate="{StaticResource SkillTemplate}"/>
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding RightSkills}" ItemTemplate="{StaticResource SkillTemplate}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
