<Page x:Class="Siniskalc.Views.SpellsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:wpf="clr-namespace:Siniskalc.Wpf.Views;assembly=Siniskalc.Wpf"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Siniskalc.Views"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="HeroSpells">
    <Border Style="{StaticResource CardStyle}">
        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <CheckBox Content="Spell book" IsChecked="{Binding HasSpellBook}" IsEnabled="{Binding CanChangeSpellBook}" Margin="0,0,20,0" VerticalAlignment="Center"
                          ToolTip="Without a spell book the hero cannot cast the learned spells. An artifact such as Titan's Thunder gives one."/>
                <Button Content="Learn all" Padding="10,2" Margin="0,0,6,0" Command="{Binding LearnAllCommand}"
                        ToolTip="Learn every spell in the list below"/>
                <Button Content="Forget all" Padding="10,2" Command="{Binding ForgetAllCommand}"
                        ToolTip="Forget every spell in the list below"/>
            </WrapPanel>
            <wpf:FinderView DataContext="{Binding Finder}" ListMaxHeight="Infinity"/>
        </DockPanel>
    </Border>
</Page>
