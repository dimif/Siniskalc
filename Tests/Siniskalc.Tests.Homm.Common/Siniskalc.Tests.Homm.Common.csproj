<Project Sdk="Microsoft.NET.Sdk">

  <!-- What the test projects of Siniskalc.Homm2 and Siniskalc.Homm3 would otherwise each carry a copy of. It holds no test and references no game. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="NUnit" Version="4.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Siniskalc.Core\Siniskalc.Core.csproj" />
    <ProjectReference Include="..\..\Siniskalc.Heroes\Siniskalc.Heroes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

</Project>
